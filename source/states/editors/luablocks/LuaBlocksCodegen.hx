package states.editors.luablocks;

import states.editors.eventcreator.EventDef.BlockDef;
import states.editors.eventcreator.EventDef.BlockFieldDef;
import states.editors.luablocks.LuaBlocksProject;

using StringTools;
using Lambda;

class LuaBlocksCodegen
{
	final palette:Map<String, BlockDef>;
	final lines:Array<String> = [];
	var usesWait:Bool = false;
	var usesTween:Bool = false;
	var usesTrigger:Bool = false;
	var usesNumber:Bool = false;
	var usesAuto:Bool = false;

	public static function generate(project:LuaBlocksProject, palette:Map<String, BlockDef>):String
		return new LuaBlocksCodegen(palette).build(project);

	function new(palette:Map<String, BlockDef>)
		this.palette = palette;

	function build(project:LuaBlocksProject):String
	{
		for (index => stack in project.stacks)
			if (stack.blocks.length > 0)
				emitStack(stack, index);

		for (hat in LuaBlocksProject.hats)
		{
			var active = project.stacks.exists(stack -> stack.hat == hat.id && stack.blocks.length > 0);
			var handlesWait = hat.id == 'onTimerCompleted' && usesWait;
			if (!active && !handlesWait)
				continue;
			var args = hat.params.join(', ');
			var signature = (hat.id == 'onBeatHit' || hat.id == 'onStepHit') ? '' : args;
			line('function ' + hat.id + '($signature)');
			if (handlesWait)
				line('if resumeWait(tag) then return end', 1);
			if (hat.id == 'onTimerCompleted' && active)
				line("if type(tag) == 'string' and tag:sub(1, 13) == '__lua_blocks_' then return end", 1);
			for (index => stack in project.stacks)
				if (stack.hat == hat.id && stack.blocks.length > 0)
					line('stack$index($args)', 1);
			line('end\n');
		}

		var prefix = ['-- Generated by Super Plus Engine Lua Blocks Editor.', ''];
		if (usesWait || usesTween)
		{
			prefix.push('local scriptIdentity = {}');
			// Keep the table alive so its address stays unique across loaded scripts.
			prefix.push("local function scriptTag(suffix) return '__lua_blocks_' .. tostring(scriptIdentity) .. '_' .. suffix end");
		}
		if (usesNumber)
		{
			prefix.push('local function numberOr(value, fallback)');
			prefix.push('    local n = tonumber(value)');
			prefix.push('    if not n or n ~= n or math.abs(n) == math.huge then return fallback end');
			prefix.push('    return n');
			prefix.push('end\n');
		}
		if (usesAuto)
		{
			prefix.push('local function eventValue(value)');
			prefix.push("    if value == 'true' then return true end");
			prefix.push("    if value == 'false' then return false end");
			prefix.push("    return numberOr(value, value or '')");
			prefix.push('end\n');
		}
		if (usesTrigger)
		{
			prefix.push('local firing = {}');
			prefix.push('local function fireEvent(current, name, first, second)');
			prefix.push("    if name == '' or name == current or firing[name] then return end");
			prefix.push('    firing[name] = true');
			prefix.push('    local ok, message = pcall(triggerEvent, name, first, second)');
			prefix.push('    firing[name] = nil');
			prefix.push('    if not ok then error(message, 0) end');
			prefix.push('end\n');
		}
		if (usesWait)
		{
			prefix.push('local pending, waitId = {}, 0');
			prefix.push('local function wait(seconds, continuation, release)');
			prefix.push('    waitId = waitId + 1');
			prefix.push("    local tag = scriptTag('wait_' .. waitId)");
			prefix.push('    pending[tag] = {continuation, release}');
			prefix.push('    local ok, message = pcall(runTimer, tag, math.max(0.001, seconds), 1)');
			prefix.push('    if not ok then pending[tag] = nil; error(message, 0) end');
			prefix.push('end\n');
			prefix.push('local function resumeWait(tag)');
			prefix.push('    local task = pending[tag]');
			prefix.push('    if not task then return false end');
			prefix.push('    pending[tag] = nil');
			prefix.push('    local ok, message = pcall(task[1])');
			prefix.push('    if not ok then');
			prefix.push('        if task[2] then task[2]() end');
			prefix.push('        error(message, 0)');
			prefix.push('    end');
			prefix.push('    return true');
			prefix.push('end\n');
		}
		return prefix.concat(lines).join('\n').trim() + '\n';
	}

	function emitStack(stack:LuaBlockStack, index:Int):Void
	{
		var hat = LuaBlocksProject.getHat(stack.hat);
		var gate = hat.id == 'onUpdate' && stack.blocks.exists(block -> block.id == 'wait');
		if (gate)
		{
			line('local busy$index = false');
			line('local function release$index() busy$index = false end');
		}
		line('local function stack$index(' + hat.params.join(', ') + ')');
		var filter = stack.filter.trim();
		if (filter != '' && hat.filterExpr != null)
		{
			var value = switch (hat.id)
			{
				case 'onBeatHit', 'onStepHit': number(filter, true, hat.filterLabel);
				default: quote(filter);
			};
			line('if ' + hat.filterExpr + ' ~= $value then return end', 1);
		}
		var depth = 1;
		if (gate)
		{
			line('if busy$index then return end', depth);
			line('busy$index = true', depth);
			line('local ok, message = pcall(function()', depth++);
		}
		var startDepth = depth;
		for (position => block in stack.blocks)
		{
			var def = palette.get(block.id);
			if (def == null)
				throw 'Unknown block: ' + block.id;
			try
			{
				if (def.special == 'wait')
				{
					usesWait = true;
					var seconds = expression(def.fields[0], block.values[0], hat);
					line('wait($seconds, function()', depth++);
				}
				else
					emitAction(def, block, hat, index, position, depth);
			}
			catch (e:Dynamic)
				throw hat.id + ' / ' + def.name + ' (block ' + (position + 1) + '): ' + Std.string(e);
		}
		if (gate)
			line('release$index()', depth);
		var afterWait = gate ? ', release$index)' : ')';
		while (depth > startDepth)
			line('end' + afterWait, --depth);
		if (gate)
		{
			line('end)', --depth);
			line('if not ok then release$index(); error(message, 0) end', depth);
		}
		line('end\n');
	}

	function emitAction(def:BlockDef, block:LuaBlock, hat:LuaBlockHat, stack:Int, position:Int, depth:Int):Void
	{
		var args:Map<String, String> = [];
		var valueIndex = 0;
		for (field in def.fields)
		{
			if (field.type == 'tag')
			{
				usesTween = true;
				args.set(field.key, 'scriptTag("tween_' + stack + '_' + position + '_' + field.key + '")');
			}
			else
				args.set(field.key, expression(field, block.values[valueIndex++], hat));
		}
		if (def.id == 'trigger_event')
		{
			usesTrigger = true;
			var current = hat.id == 'onEvent' ? 'name' : 'nil';
			line('fireEvent(' + [current, args.get('event'), args.get('value1'), args.get('value2')].join(', ') + ')', depth);
			return;
		}
		var template = ~/\$([A-Za-z_][A-Za-z0-9_]*)/g.map(def.template, token -> args.get(token.matched(1)));
		for (statement in template.split('\n'))
			line(statement, depth);
	}

	function expression(field:BlockFieldDef, value:LuaBlockValue, hat:LuaBlockHat):String
	{
		if (value.source != '')
		{
			var source = value.source;
			if (!hat.params.contains(source))
				throw 'Parameter ' + source + ' is unavailable here';
			return switch (field.type)
			{
				case 'int', 'float':
					usesNumber = true;
					var fallback = number(field.def ?? '0', field.type == 'int', field.label);
					var converted = 'numberOr($source, $fallback)';
					field.type == 'int' ? 'math.floor($converted)' : converted;
				case 'bool':
					'($source == true or $source == 1 or $source == "true" or $source == "1")';
				case 'auto':
					usesNumber = usesAuto = true;
					'eventValue($source)';
				default:
					'tostring($source or "")';
			};
		}

		var raw = value.text;
		var trimmed = raw.trim();
		return switch (field.type)
		{
			case 'float', 'int':
				number(trimmed, field.type == 'int', field.label);
			case 'bool':
				if (!['true', 'false', '1', '0'].contains(trimmed))
					throw field.label + ' needs true or false';
				trimmed == 'true' || trimmed == '1' ? 'true' : 'false';
			case 'auto':
				if (trimmed == 'true' || trimmed == 'false')
					trimmed;
				else if (isNumber(trimmed, false))
					number(trimmed, false, field.label);
				else
					quote(raw);
			case 'spriteTag':
				if (trimmed == '' || trimmed.contains('.'))
					throw 'Enter a sprite tag without dots';
				quote(trimmed);
			case 'timerTag':
				if (trimmed == '' || trimmed.startsWith('__lua_blocks_'))
					throw 'Enter a name for this timer';
				quote(trimmed);
			default:
				quote(raw);
		};
	}

	static function isNumber(value:String, integer:Bool):Bool
		return integer ? ~/^[+-]?[0-9]+$/.match(value) : ~/^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$/.match(value);

	static function number(value:String, integer:Bool, label:String):String
	{
		var n = Std.parseFloat(value);
		if (!isNumber(value, integer) || !Math.isFinite(n))
			throw label + (integer ? ' needs an integer' : ' needs a number');
		return Std.string(n);
	}

	static function quote(value:String):String
	{
		return '"' + ~/["\\\x00-\x1f\x7f]/g.map(value, function(token)
		{
			var char = token.matched(0);
			return char == '"' || char == '\\' ? '\\' + char : '\\' + Std.string(char.charCodeAt(0)).lpad('0', 3);
		}) + '"';
	}

	function line(text:String, depth:Int = 0):Void
		lines.push([for (_ in 0...depth) '    '].join('') + text);
}

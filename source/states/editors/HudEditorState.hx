	public function UIEvent(id:String, sender:Dynamic)
	{
		switch (id)
		{
			case PsychUICheckBox.CLICK_EVENT:
				if (!uiUpdating)
					unsavedProgress = true;

			case PsychUIInputText.CHANGE_EVENT, PsychUINumericStepper.CHANGE_EVENT:
				if (!uiUpdating)
					unsavedProgress = true;
		}
	}


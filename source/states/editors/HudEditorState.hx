	function copyToClipboard():Bool
	{
		try
		{
			Clipboard.text = exportLua;
			showOutput('Snippet copied to the clipboard.');
			return true;
		}
		catch (e:Dynamic)
		{
			showOutput('Clipboard not available here: use "Save as file".', true);
		}
		return false;
	}

	function openExportPanel()
	{
		stopPreview();
		if (tweenCaptureActive)
			cancelTweenCapture();

		exportLua = generateLua();
		exportLines = exportLua.replace('\t', '    ').split('\n');
		exportScroll = 0;

		var song:String = currentSongName();
		var copied:Bool = true;
		try
		{
			Clipboard.text = exportLua;
		}
		catch (e:Dynamic)
		{
			copied = false;
		}
		exportInfo.text = (copied ? 'Already copied to the clipboard. ' : 'Clipboard not available. ')
			+ 'Paste it into your song lua. "Save as file" writes ${song}_hud.lua: if you put it in data/songs/$song/ Psych loads it by itself '
			+ '(do NOT also call addLuaScript).';
		refreshExportText();
		exportGroup.visible = exportGroup.active = exportOpen = true;
	}

	function closeExportPanel()
	{
		exportGroup.visible = exportGroup.active = exportOpen = false;
	}

	function refreshExportText()
	{
		var maxScroll:Int = Std.int(Math.max(0, exportLines.length - EXPORT_LINES));
		exportScroll = Std.int(FlxMath.bound(exportScroll, 0, maxScroll));
		var shown:Array<String> = exportLines.slice(exportScroll, exportScroll + EXPORT_LINES);
		exportText.text = shown.join('\n');
	}

	function updateExportPanel(elapsed:Float)
	{
		exportGroup.update(elapsed);

		if (FlxG.keys.justPressed.ESCAPE)
		{
			closeExportPanel();
			return;
		}
		if (FlxG.mouse.wheel != 0)
		{
			exportScroll -= FlxG.mouse.wheel * 3;
			refreshExportText();
		}
		if (FlxG.keys.justPressed.PAGEUP)
		{
			exportScroll -= EXPORT_LINES;
			refreshExportText();
		}
		if (FlxG.keys.justPressed.PAGEDOWN)
		{
			exportScroll += EXPORT_LINES;
			refreshExportText();
		}
	}

	function currentSongName():String
	{
		var s:String = (songDropDown != null && songDropDown.selectedLabel != null && songDropDown.selectedLabel.length > 0) ? songDropDown.selectedLabel : songName;
		return (s == null || s.length < 1) ? 'song' : s;
	}

	// -------------------------------------------------------------------
	// Salvataggio come file (opzionale): <song>_hud.lua
	// -------------------------------------------------------------------
	var _file:FileReference;

	function saveLuaFile()
	{
		if (_file != null)
			return;

		var fileName:String = currentSongName() + '_hud.lua';
		#if mobile
		StorageUtil.saveContent(fileName, exportLua);
		unsavedProgress = false;
		#else
		startSave(exportLua, fileName);
		#end
	}

	function startSave(content:String, name:String)
	{
		_file = new FileReference();
		_file.addEventListener(#if desktop Event.SELECT #else Event.COMPLETE #end, onSaveComplete);
		_file.addEventListener(Event.CANCEL, onSaveCancel);
		_file.addEventListener(IOErrorEvent.IO_ERROR, onSaveError);
		_file.save(content, name);
	}

	function clearSaveListeners()
	{
		if (_file == null)
			return;
		_file.removeEventListener(#if desktop Event.SELECT #else Event.COMPLETE #end, onSaveComplete);
		_file.removeEventListener(Event.CANCEL, onSaveCancel);
		_file.removeEventListener(IOErrorEvent.IO_ERROR, onSaveError);
		_file = null;
	}

	function onSaveComplete(_):Void
	{
		clearSaveListeners();
		unsavedProgress = false;
		FlxG.log.notice('Successfully saved file.');
	}

	function onSaveCancel(_):Void
	{
		clearSaveListeners();
	}

	function onSaveError(_):Void
	{
		clearSaveListeners();
		FlxG.log.error('Problem saving file');
	}

	// -------------------------------------------------------------------
	// Generazione Lua
	// -------------------------------------------------------------------
	function luaStr(s:String):String
		return "'" + s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n") + "'";

	function luaNum(v:Float):String
	{
		var f:Float = Math.round(v * 10000) / 10000;
		if (Math.isNaN(f))
			f = 0;
		return Std.string(f);
	}

	// Numero per codice Haxe (HScript): sempre con il punto decimale
	function hxNum(v:Float):String
	{
		var s:String = luaNum(v);
		if (s.indexOf('.') < 0 && s.indexOf('e') < 0)
			s += '.0';
		return s;
	}

	function differs(a:Float, b:Float):Bool
		return Math.abs(a - b) > 0.0001;

	function safeEase(name:String):String
		return EASE_LIST.contains(name) ? name : 'linear';

	function widgetKey(m:EditorMetaSprite):String
		return m.name; // i nomi dei widget coincidono con i nomi interni di PlayState

	function setLine(m:EditorMetaSprite, field:String, val:String):String
	{
		if (m.type == 'strum')
			return "setPropertyFromGroup('strumLineNotes', " + m.targetIndex + ", '" + field + "', " + val + ")";
		return "setProperty('" + widgetKey(m) + "." + field + "', " + val + ")";
	}

	// Solo il DIFF rispetto al default (se coincide: niente, per ridurre le collisioni con altri script)
	function staticLines(m:EditorMetaSprite):Array<String>
	{
		var l:Array<String> = [];
		var isCombo:Bool = (m.type == 'combo');

		if (differs(m.x, m.defaultX))
			l.push(setLine(m, 'x', luaNum(isCombo ? m.x - m.defaultX : m.x)));
		if (differs(m.y, m.defaultY))
			l.push(setLine(m, 'y', luaNum(isCombo ? m.y - m.defaultY : m.y)));
		if (differs(m.alpha, m.defaultAlpha))
			l.push(setLine(m, 'alpha', luaNum(m.alpha)));
		if (m.canRotate && differs(m.angle, 0))
			l.push(setLine(m, 'angle', luaNum(m.angle)));
		if (m.canScale && (differs(m.scale[0], m.defaultScaleX) || differs(m.scale[1], m.defaultScaleY)))
		{
			l.push(setLine(m, 'scale.x', luaNum(m.scale[0])));
			l.push(setLine(m, 'scale.y', luaNum(m.scale[1])));
		}

		// tiene coerenti le variabili "default" che usano i modchart
		if (m.type == 'strum')
		{
			var pre:String = (m.targetIndex >= 4) ? 'defaultPlayerStrum' : 'defaultOpponentStrum';
			var n:Int = m.targetIndex % 4;
			if (differs(m.x, m.defaultX))
				l.push(pre + 'X' + n + ' = ' + luaNum(m.x));
			if (differs(m.y, m.defaultY))
				l.push(pre + 'Y' + n + ' = ' + luaNum(m.y));
		}
		return l;
	}

	function haxeRef(t:HudTweenData):String
	{
		return switch (t.targetType)
		{
			case 'strum': 'PlayState.instance.strumLineNotes.members[' + t.targetIndex + ']';
			case 'overlay': "PlayState.instance.modchartSprites.get('" + t.targetName + "')";
			default: 'PlayState.instance.' + t.targetName;
		}
	}

	// Righe che AVVIANO il tween n (parte sempre dal valore A, poi va a B)
	function tweenLines(t:HudTweenData, n:Int):Array<String>
	{
		if (t.keys.length < 2)
			return ['-- tween ' + n + ' (' + t.targetName + '): needs at least 2 keyframes, skipped'];
		if (t.keys.length > 2)
			return chainLines(t, n);
		var a:HudKeyframe = t.keys[0];
		var b:HudKeyframe = t.keys[1];
		var L:Array<String> = [];
		var doX:Bool = t.propX && differs(a.x, b.x);
		var doY:Bool = t.propY && differs(a.y, b.y);
		var doA:Bool = t.propAlpha && differs(a.alpha, b.alpha);
		var doAng:Bool = t.propAngle && differs(a.angle, b.angle);
		var doS:Bool = t.propScale && differs(a.scale, b.scale);

		if (!(doX || doY || doA || doAng || doS))
		{
			L.push('-- tween ' + n + ' (' + t.targetName + '): no property changes between A and B, skipped');
			return L;
		}

		var ease:String = safeEase(b.easing);
		var dur:String = luaNum(b.duration);
		var mode:String = t.yoyo ? ', yoyo (ping-pong)' : (t.loop ? ', loop' : '');
		L.push('-- tween ' + n + ': ' + t.targetName + ' (' + b.easing + ', ' + dur + 's' + (t.delay > 0 ? ', delay ' + luaNum(t.delay) + 's' : '') + mode + ')');

		var simple:Bool = (t.targetType == 'overlay' && t.delay <= 0 && !t.loop && !t.yoyo);
		if (simple)
		{
			// overlay: API stabile doTween*
			var tag:String = luaStr(t.targetName);
			var base:String = 'hudTween' + n;
			if (doX)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.x') + ', ' + luaNum(a.x) + ')');
				L.push('doTweenX(' + luaStr(base + '_x') + ', ' + tag + ', ' + luaNum(b.x) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doY)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.y') + ', ' + luaNum(a.y) + ')');
				L.push('doTweenY(' + luaStr(base + '_y') + ', ' + tag + ', ' + luaNum(b.y) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doA)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.alpha') + ', ' + luaNum(a.alpha) + ')');
				L.push('doTweenAlpha(' + luaStr(base + '_a') + ', ' + tag + ', ' + luaNum(b.alpha) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doAng)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.angle') + ', ' + luaNum(a.angle) + ')');
				L.push('doTweenAngle(' + luaStr(base + '_ang') + ', ' + tag + ', ' + luaNum(b.angle) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doS)
			{
				// Psych non ha doTweenScale: si tweena x/y dell'oggetto "scale"
				var sc:String = luaStr(t.targetName + '.scale');
				L.push('setProperty(' + luaStr(t.targetName + '.scale.x') + ', ' + luaNum(a.scale) + ')');
				L.push('setProperty(' + luaStr(t.targetName + '.scale.y') + ', ' + luaNum(a.scale) + ')');
				L.push('doTweenX(' + luaStr(base + '_sx') + ', ' + sc + ', ' + luaNum(b.scale) + ', ' + dur + ', ' + luaStr(ease) + ')');
				L.push('doTweenY(' + luaStr(base + '_sy') + ', ' + sc + ', ' + luaNum(b.scale) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			return L;
		}

		// strum / widget nativi (e overlay con delay/loop/yoyo): runHaxeCode
		var opts:String = '{ease: FlxEase.' + ease + (t.delay > 0 ? ', startDelay: ' + hxNum(t.delay) : '') + (t.yoyo ? ', type: 4' : (t.loop ? ', type: 2' : '')) + '}';
		L.push('runHaxeCode([[');
		L.push('\tvar obj = ' + haxeRef(t) + ';');
		L.push('\tif (obj != null) {');
		if (doX)
			L.push('\t\tobj.x = ' + hxNum(a.x) + ';');
		if (doY)
			L.push('\t\tobj.y = ' + hxNum(a.y) + ';');
		if (doA)
			L.push('\t\tobj.alpha = ' + hxNum(a.alpha) + ';');
		if (doAng)
			L.push('\t\tobj.angle = ' + hxNum(a.angle) + ';');
		if (doS)
		{
			L.push('\t\tobj.scale.x = ' + hxNum(a.scale) + ';');
			L.push('\t\tobj.scale.y = ' + hxNum(a.scale) + ';');
		}

		var vals:Array<String> = [];
		if (doX)
			vals.push('x: ' + hxNum(b.x));
		if (doY)
			vals.push('y: ' + hxNum(b.y));
		if (doA)
			vals.push('alpha: ' + hxNum(b.alpha));
		if (doAng)
			vals.push('angle: ' + hxNum(b.angle));
		if (vals.length > 0)
			L.push('\t\tFlxTween.tween(obj, {' + vals.join(', ') + '}, ' + hxNum(b.duration) + ', ' + opts + ');');
		if (doS)
			L.push('\t\tFlxTween.tween(obj.scale, {x: ' + hxNum(b.scale) + ', y: ' + hxNum(b.scale) + '}, ' + hxNum(b.duration) + ', ' + opts + ');');
		L.push('\t}');
		L.push(']])');
		return L;
	}

	// Tween a catena (3+ keyframe): runHaxeCode con FlxTween concatenati via onComplete.
	// (startDelay cumulativo NON e' affidabile: i valori di partenza verrebbero letti troppo presto.)
	function chainLines(t:HudTweenData, n:Int):Array<String>
	{
		var L:Array<String> = [];
		var k:Array<HudKeyframe> = t.keys;

		var fx:Bool = false;
		var fy:Bool = false;
		var fa:Bool = false;
		var fang:Bool = false;
		var fs:Bool = false;
		for (i in 1...k.length)
		{
			if (differs(k[i - 1].x, k[i].x))
				fx = true;
			if (differs(k[i - 1].y, k[i].y))
				fy = true;
			if (differs(k[i - 1].alpha, k[i].alpha))
				fa = true;
			if (differs(k[i - 1].angle, k[i].angle))
				fang = true;
			if (differs(k[i - 1].scale, k[i].scale))
				fs = true;
		}
		var fl = {x: t.propX && fx, y: t.propY && fy, a: t.propAlpha && fa, ang: t.propAngle && fang, s: t.propScale && fs};

		if (!(fl.x || fl.y || fl.a || fl.ang || fl.s))
		{
			L.push('-- tween ' + n + ' (' + t.targetName + '): no property changes between keyframes, skipped');
			return L;
		}

		var loopy:Bool = t.loop || t.yoyo;
		var mode:String = t.yoyo ? ', yoyo (forward + back, repeated)' : (t.loop ? ', loop (restarts from A)' : '');
		L.push('-- tween ' + n + ': ' + t.targetName + ' — chain of ' + k.length + ' keyframes' + (t.delay > 0 ? ', delay ' + luaNum(t.delay) + 's' : '') + mode);
		for (i in 1...k.length)
			L.push('--   ' + keyName(i - 1) + ' -> ' + keyName(i) + ': ' + luaNum(k[i].duration) + 's ' + safeEase(k[i].easing));

		var segs:Array<HudSeg> = buildSegs(t, t.yoyo);
		var a:HudKeyframe = k[0];

		L.push('runHaxeCode([[');
		L.push('\tvar obj = ' + haxeRef(t) + ';');
		L.push('\tif (obj != null) {');
		var ind:String = '\t\t';
		if (loopy)
		{
			L.push(ind + 'var run = null;');
			L.push(ind + 'run = function(first) {');
			ind += '\t';
		}
		// si parte sempre dal valore A
		if (fl.x)
			L.push(ind + 'obj.x = ' + hxNum(a.x) + ';');
		if (fl.y)
			L.push(ind + 'obj.y = ' + hxNum(a.y) + ';');
		if (fl.a)
			L.push(ind + 'obj.alpha = ' + hxNum(a.alpha) + ';');
		if (fl.ang)
			L.push(ind + 'obj.angle = ' + hxNum(a.angle) + ';');
		if (fl.s)
		{
			L.push(ind + 'obj.scale.x = ' + hxNum(a.scale) + ';');
			L.push(ind + 'obj.scale.y = ' + hxNum(a.scale) + ';');
		}
		chainSeg(L, segs, 0, ind, fl, t, loopy);
		if (loopy)
		{
			L.push('\t\t};');
			L.push('\t\trun(true);');
		}
		L.push('\t}');
		L.push(']])');
		return L;
	}

	// Un segmento: se non e' l'ultimo (o se c'e' loop) il successivo sta dentro onComplete
	function chainSeg(L:Array<String>, segs:Array<HudSeg>, i:Int, ind:String, fl:{x:Bool, y:Bool, a:Bool, ang:Bool, s:Bool}, t:HudTweenData, loopy:Bool)
	{
		var sg:HudSeg = segs[i];
		var last:Bool = (i == segs.length - 1);
		var needCb:Bool = !last || loopy;

		var delayStr:String = '';
		if (i == 0 && t.delay > 0)
			delayStr = loopy ? ', startDelay: (first ? ' + hxNum(t.delay) + ' : 0.0)' : ', startDelay: ' + hxNum(t.delay);
		var optsHead:String = '{ease: FlxEase.' + safeEase(sg.ease) + delayStr;
		var dur:String = hxNum(sg.dur);

		var vals:Array<String> = [];
		if (fl.x)
			vals.push('x: ' + hxNum(sg.x));
		if (fl.y)
			vals.push('y: ' + hxNum(sg.y));
		if (fl.a)
			vals.push('alpha: ' + hxNum(sg.alpha));
		if (fl.ang)
			vals.push('angle: ' + hxNum(sg.angle));
		var hasObj:Bool = vals.length > 0;

		// chi porta la continuazione: il tween dell'oggetto, altrimenti quello della scala
		function emit(target:String, valStr:String, withCb:Bool)
		{
			var head:String = ind + 'FlxTween.tween(' + target + ', ' + valStr + ', ' + dur + ', ' + optsHead;
			if (!withCb)
			{
				L.push(head + '});');
				return;
			}
			L.push(head + ', onComplete: function(_) {');
			if (!last)
				chainSeg(L, segs, i + 1, ind + '\t', fl, t, loopy);
			else
				L.push(ind + '\trun(false);');
			L.push(ind + '}});');
		}

		if (fl.s)
			emit('obj.scale', '{x: ' + hxNum(sg.scale) + ', y: ' + hxNum(sg.scale) + '}', needCb && !hasObj);
		if (hasObj)
			emit('obj', '{' + vals.join(', ') + '}', needCb);
	}

	// ---------------------------------------------------------------
	// Draw order GLOBALE. Strategia (Psych 1.0.x: comboGroup < noteGroup < uiGroup, nell'ordine fisso di PlayState):
	//  - overlay e comboGroup sono membri diretti di PlayState: si piazzano con setObjectOrder subito
	//    DOPO l'ultimo contenitore/oggetto che devono stare sopra (hudPlaceAfter, indici ricalcolati a runtime);
	//  - healthBar/scoreTxt/timeTxt/timeBar stanno in uiGroup: si rimescolano tra i LORO slot (icone e
	//    botplayTxt restano dove sono);
	//  - gli strum stanno in noteGroup (indice strumLineNotes.members[i] da non toccare): contano come
	//    ancora "noteGroup", non si riordinano tra loro.
	// Se nessuno zIndex e' stato cambiato rispetto al default non emette NIENTE.
	// ---------------------------------------------------------------
	function drawOrderLines():Array<String>
	{
		var L:Array<String> = [];
		var changed:Bool = false;
		for (m in items)
			if (m.zIndex != m.defaultZ)
			{
				changed = true;
				break;
			}
		if (!changed)
			return L;

		var sorted:Array<EditorMetaSprite> = sortedItems();
		L.push('-- DRAW ORDER (globale, dal fondo al top):');
		for (i => m in sorted)
			L.push('--   ' + (i + 1) + '. ' + m.name + ' (zIndex ' + m.zIndex + ')');

		L.push('local function hudPlaceAfter(tag, anchors)');
		L.push('\tif #anchors == 0 then');
		L.push('\t\tsetObjectOrder(tag, 0)');
		L.push('\t\treturn');
		L.push('\tend');
		L.push('\tlocal top = -1');
		L.push('\tfor _, a in ipairs(anchors) do');
		L.push('\t\tlocal idx = getObjectOrder(a)');
		L.push('\t\tif idx > top then top = idx end');
		L.push('\tend');
		L.push('\tif top < 0 then return end');
		L.push('\tif getObjectOrder(tag) < top then');
		L.push('\t\tsetObjectOrder(tag, top) -- rimuovendo tag, l\'ancora scala di 1');
		L.push('\telse');
		L.push('\t\tsetObjectOrder(tag, top + 1)');
		L.push('\tend');
		L.push('end');

		var seen:Array<String> = [];
		var lastMovable:String = null;
		var uiNow:Array<String> = [];
		for (m in sorted)
		{
			var container:String = switch (m.type)
			{
				case 'strum': 'noteGroup';
				case 'overlay', 'combo': null;
				default: 'uiGroup';
			}
			if (container != null)
			{
				if (!seen.contains(container))
					seen.push(container);
				if (container == 'uiGroup')
					uiNow.push(m.name);
				continue;
			}
			var tag:String = (m.type == 'combo') ? 'comboGroup' : m.name;
			var anchors:Array<String> = seen.copy();
			if (lastMovable != null)
				anchors.push(lastMovable);
			L.push('hudPlaceAfter(' + luaStr(tag) + ', {' + [for (a in anchors) luaStr(a)].join(', ') + '})');
			lastMovable = tag;
		}

		// widget di uiGroup: rimescolo solo se il loro ordine relativo e' cambiato
		var uiDef:Array<String> = [];
		var byDef:Array<EditorMetaSprite> = [for (m in items) if (m.type == 'healthbar' || m.type == 'scoreText' || m.type == 'timeText' || m.type == 'timeBar') m];
		byDef.sort(function(a:EditorMetaSprite, b:EditorMetaSprite):Int return a.defaultZ - b.defaultZ);
		for (m in byDef)
			uiDef.push(m.name);
		if (uiNow.join(',') != uiDef.join(','))
		{
			L.push('runHaxeCode([[');
			L.push('\tvar g = PlayState.instance;');
			L.push('\tvar grp = g.uiGroup;');
			L.push('\tif (grp != null) {');
			L.push('\t\tvar objs = [];');
			L.push('\t\tfor (o in [' + [for (n in uiNow) 'g.' + n].join(', ') + ']) {');
			L.push('\t\t\tif (o != null && grp.members.indexOf(o) >= 0) objs.push(o);');
			L.push('\t\t}');
			L.push('\t\tvar slots = [];');
			L.push('\t\tfor (o in objs) slots.push(grp.members.indexOf(o));');
			L.push('\t\tslots.sort(function(a, b) return a - b);');
			L.push('\t\tfor (i in 0...objs.length) grp.members[slots[i]] = objs[i];');
			L.push('\t}');
			L.push(']])');
		}
		return L;
	}

	function indent(lines:Array<String>, prefix:String):Array<String>
		return [for (l in lines) (l.length > 0 ? prefix + l : l)];

	function generateLua():String
	{
		var song:String = currentSongName();
		var out:Array<String> = [];

		// ---- HEADER obbligatorio (identico alla specifica) ----
		out.push("-- ============================================================");
		out.push("-- HUD Layout — generated by Psych Engine HUD Editor");
		out.push("-- Song: " + song);
		out.push("-- ============================================================");
		out.push("--");
		out.push("-- COME USARLO:");
		out.push("--   Incolla questo codice in onCreatePost() del tuo");
		out.push("--   data/songs/" + song + "/" + song + ".lua, oppure salvalo come");
		out.push("--   " + song + "_hud.lua e caricalo con addLuaScript() in onCreatePost.");
		out.push("--");
		out.push("-- ORDINE DI ESECUZIONE:");
		out.push("--   Psych esegue i lua in sequenza e per le stesse proprietà vince");
		out.push("--   l'ultimo che scrive. Se un altro script tocca gli stessi elementi");
		out.push("--   DOPO questo codice, quel script vince. Non c'è merge automatico.");
		out.push("--   Incolla DOPO le tue modifiche se vuoi che l'editor abbia");
		out.push("--   l'ultima parola, PRIMA se vuoi che le tue vincano.");
		out.push("--");
		out.push("-- DRAW ORDER:");
		out.push("--   L'ordine di disegno (zIndex) e' GLOBALE: una sola lista per tutto l'HUD,");
		out.push("--   NON per categoria (strum, widget e overlay si possono interlacciare).");
		out.push("--   Il codice emesso usa setObjectOrder per overlay e comboGroup e rimescola");
		out.push("--   healthBar/scoreTxt/timeTxt/timeBar dentro uiGroup. Limite: noteGroup (strum+note),");
		out.push("--   uiGroup e comboGroup restano nell'ordine fisso di Psych; gli strum non si");
		out.push("--   riordinano tra loro (romperebbe strumLineNotes.members[i]).");
		out.push("--");
		out.push("-- VERSIONE: testato su Psych 1.0.x vanilla. runHaxeCode per i");
		out.push("-- widget nativi richiede HScript abilitato. I nomi interni");
		out.push("-- (strumLineNotes, healthBar, ecc.) possono cambiare tra fork.");
		out.push("-- ============================================================");
		out.push("");

		// ---- Note dell'editor (aggiunte DOPO l'header obbligatorio) ----
		out.push("-- NOTE DELL'EDITOR:");
		out.push("--   * Modalita' assunta: downscroll=" + downscroll + ", middlescroll=" + middlescroll + ", 4K (il PlayState di questo fork e' solo 4K).");
		out.push("--     I diff sono calcolati rispetto ai default di quella modalita'; le posizioni emesse sono assolute.");
		out.push("--   * Strum: opponent = strumLineNotes 0-3, player = 4-7 (Psych 1.0.x vanilla; altri fork possono usare strumLineNotesP1/P2).");
		out.push("--   * Gli strum esistono solo dopo startCountdown(): le loro posizioni statiche stanno in onCountdownStarted().");
		out.push("--   * Se il tuo script ha GIA' onCreate/onCreatePost/onCountdownStarted/onBeatHit/onStepHit, in Lua resta solo l'ULTIMA");
		out.push("--     definizione di ogni funzione: copia i CORPI dentro le tue funzioni invece di incollare le funzioni intere.");
		out.push("--   * Un file " + song + "_hud.lua in data/songs/" + song + "/ viene caricato da Psych in automatico (non serve addLuaScript).");
		out.push("--   * Il tween parte sempre dal valore A (impostato subito prima del tween) e arriva a B.");
		out.push("--   * Tween a catena (3+ keyframe): runHaxeCode con FlxTween concatenati via onComplete; loop = riparte da A,");
		out.push("--     yoyo = andata + ritorno ripetuti. Durata/easing sono per segmento.");
		out.push("--   * Draw order: emesso solo se hai cambiato qualche zIndex rispetto al default (vedi DRAW ORDER nell'header).");
		out.push("--   * comboGroup: i valori x/y sono uno SPOSTAMENTO rispetto alla posizione normale (il gruppo parte da 0,0).");
		out.push("");

		// ---- Overlay (function onCreate) ----
		var overlays:Array<EditorMetaSprite> = [for (m in items) if (m.type == 'overlay') m];
		if (overlays.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- OVERLAY IMPORTATI");
			out.push("-- ------------------------------------------------------------");
			out.push("function onCreate()");
			for (m in overlays)
			{
				var tag:String = luaStr(m.name);
				var img:String = luaStr(m.image);
				out.push("\t-- overlay: " + m.name);
				out.push("\t" + (m.animated ? "makeAnimatedLuaSprite(" : "makeLuaSprite(") + tag + ", " + img + ", " + luaNum(m.x) + ", " + luaNum(m.y) + ")");
				out.push("\tsetObjectCamera(" + tag + ", 'hud')");
				out.push("\tsetScrollFactor(" + tag + ", 0, 0)");
				if (differs(m.scale[0], 1) || differs(m.scale[1], 1))
					out.push("\tscaleObject(" + tag + ", " + luaNum(m.scale[0]) + ", " + luaNum(m.scale[1]) + ")");
				if (differs(m.alpha, 1))
					out.push("\tsetProperty(" + luaStr(m.name + '.alpha') + ", " + luaNum(m.alpha) + ")");
				if (differs(m.angle, 0))
					out.push("\tsetProperty(" + luaStr(m.name + '.angle') + ", " + luaNum(m.angle) + ")");
				if (m.flipX)
					out.push("\tsetProperty(" + luaStr(m.name + '.flipX') + ", true)");
				if (m.flipY)
					out.push("\tsetProperty(" + luaStr(m.name + '.flipY') + ", true)");
				if (!m.antialiasing)
					out.push("\tsetProperty(" + luaStr(m.name + '.antialiasing') + ", false)");
				if (m.animated && m.animations != null)
				{
					for (a in m.animations)
						out.push("\taddAnimationByPrefix(" + tag + ", " + luaStr(a.anim) + ", " + luaStr(a.name) + ", " + luaNum(a.fps) + ", " + (a.loop ? 'true' : 'false') + ")");
					if (m.firstAnimation != null)
						out.push("\tplayAnim(" + tag + ", " + luaStr(m.firstAnimation) + ", true)");
				}
				out.push("\taddLuaSprite(" + tag + ", true)");
				out.push("");
			}
			out.push("end");
			out.push("");
		}

		// ---- Raccolta: statici e tween ----
		var createPostStatic:Array<String> = [];
		var countdownStatic:Array<String> = [];
		for (m in items)
		{
			if (m.type == 'overlay')
				continue;
			var sl:Array<String> = staticLines(m);
			if (sl.length < 1)
				continue;
			var target:Array<String> = (m.type == 'strum') ? countdownStatic : createPostStatic;
			target.push('-- ' + m.name);
			for (l in sl)
				target.push(l);
		}

		// ordine: per trigger, poi per beat, poi per creazione
		var order:Array<Int> = [for (i in 0...hudTweens.length) i];
		order.sort(function(a:Int, b:Int):Int
		{
			var ta:HudTweenData = hudTweens[a];
			var tb:HudTweenData = hudTweens[b];
			var ra:Int = TRIGGER_LIST.indexOf(ta.trigger);
			var rb:Int = TRIGGER_LIST.indexOf(tb.trigger);
			if (ra != rb)
				return ra - rb;
			if (ta.triggerBeat != tb.triggerBeat)
				return ta.triggerBeat - tb.triggerBeat;
			return a - b;
		});

		var flags:Array<String> = [];
		var createPostTweens:Array<String> = [];
		var countdownTweens:Array<String> = [];
		var beatBlocks:Array<String> = [];
		var stepBlocks:Array<String> = [];
		var customNames:Array<String> = [];
		var customBodies:Map<String, Array<String>> = new Map();

		for (i in order)
		{
			var t:HudTweenData = hudTweens[i];
			if (indexOfTarget(t) < 0)
				continue;
			var n:Int = i + 1;
			var body:Array<String> = tweenLines(t, n);
			var flag:String = '__hudTween' + n + '_done';

			switch (t.trigger)
			{
				case 'onBeatHit', 'onStepHit':
					flags.push(flag + ' = false');
					var v:String = (t.trigger == 'onBeatHit') ? 'curBeat' : 'curStep';
					var block:Array<String> = [];
					block.push(body[0]); // commento del tween
					block.push('if ' + v + ' == ' + t.triggerBeat + ' and not ' + flag + ' then');
					block.push('\t' + flag + ' = true');
					for (k in 1...body.length)
						block.push('\t' + body[k]);
					block.push('end');
					for (l in block)
						((t.trigger == 'onBeatHit') ? beatBlocks : stepBlocks).push('\t' + l);

				case 'customFunction':
					var fn:String = (t.customFuncName != null && t.customFuncName.length > 0) ? t.customFuncName : 'hudTween' + n;
					if (!customBodies.exists(fn))
					{
						customBodies.set(fn, []);
						customNames.push(fn);
					}
					for (l in body)
						customBodies.get(fn).push('\t' + l);

				default: // onCreatePost
					var dest:Array<String> = (t.targetType == 'strum') ? countdownTweens : createPostTweens;
					for (l in body)
						dest.push('\t' + l);
			}
		}

		// ---- onCreatePost ----
		var orderLines:Array<String> = drawOrderLines();
		if (createPostStatic.length > 0 || flags.length > 0 || createPostTweens.length > 0 || orderLines.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- POSIZIONI STATICHE (solo cio' che differisce dal default)");
			out.push("-- ------------------------------------------------------------");
			out.push("function onCreatePost()");
			for (l in orderLines)
				out.push("\t" + l);
			for (l in createPostStatic)
				out.push("\t" + l);
			if (flags.length > 0)
			{
				out.push("");
				out.push("\t-- flag per tween one-shot");
				for (l in flags)
					out.push("\t" + l);
			}
			if (createPostTweens.length > 0)
			{
				out.push("");
				out.push("\t-- tween avviati alla creazione");
				for (l in createPostTweens)
					out.push(l);
			}
			out.push("end");
			out.push("");
		}

		// ---- onCountdownStarted (gli strum esistono solo qui) ----
		if (countdownStatic.length > 0 || countdownTweens.length > 0)
		{
			out.push("-- Gli strum vengono creati in startCountdown(), DOPO onCreatePost:");
			out.push("-- per questo le loro posizioni stanno qui.");
			out.push("function onCountdownStarted()");
			for (l in countdownStatic)
				out.push("\t" + l);
			for (l in countdownTweens)
				out.push(l);
			out.push("end");
			out.push("");
		}

		// ---- Tween per trigger ----
		if (beatBlocks.length > 0 || stepBlocks.length > 0 || customNames.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- TWEEN");
			out.push("-- ------------------------------------------------------------");
		}
		if (beatBlocks.length > 0)
		{
			out.push("function onBeatHit()");
			for (l in beatBlocks)
				out.push(l);
			out.push("end");
			out.push("");
		}
		if (stepBlocks.length > 0)
		{
			out.push("function onStepHit()");
			for (l in stepBlocks)
				out.push(l);
			out.push("end");
			out.push("");
		}
		for (fn in customNames)
		{
			out.push("-- Funzione custom: NON viene chiamata automaticamente.");
			out.push("-- Chiamala da questo script con " + fn + "() oppure da un altro script con callOnLuas('" + fn + "', {}).");
			out.push("function " + fn + "()");
			for (l in customBodies.get(fn))
				out.push(l);
			out.push("end");
			out.push("");
		}

		if (overlays.length < 1 && createPostStatic.length < 1 && countdownStatic.length < 1 && hudTweens.length < 1 && orderLines.length < 1)
			out.push("-- (nessuna modifica: l'HUD e' ai valori di default)");

		return out.join('\n');
	}

	// -------------------------------------------------------------------
	// Update
	// -------------------------------------------------------------------
	var showSelectionQuad:Bool = true;

	override function closeSubState()
	{
		super.closeSubState();
		controls.isInSubstate = false;
		removeTouchPad();
		addTouchPad('LEFT_FULL', 'CHARACTER_EDITOR');
		addTouchPadCamera();
		persistentUpdate = true;
	}

	override function update(elapsed:Float)
	{
		// modali: confirm, export, picker
		if (confirmOpen)
		{
			updateConfirm(elapsed);
			return;
		}
		if (exportOpen)
		{
			updateExportPanel(elapsed);
			return;
		}
		if (updatePngPicker())
			return;

		for (m in items)
			m.update(elapsed);

		super.update(elapsed);

		outputTime = Math.max(0, outputTime - elapsed);
		outputTxt.alpha = outputTime;

		if (previewRestoreTimer > 0)
		{
			previewRestoreTimer -= elapsed;
			if (previewRestoreTimer <= 0)
				stopPreview();
		}

		if (PsychUIInputText.focusOn != null)
			return;

		if (FlxG.keys.justPressed.ESCAPE || (touchPad != null && touchPad.buttonB.justPressed))
		{
			if (helpBg.visible)
			{
				helpBg.visible = helpTexts.visible = false;
				return;
			}
			if (tweenCaptureActive)
			{
				finishTweenCapture(); // ESC chiude la catena (il click destro la annulla)
				return;
			}
			if (previewMeta != null)
			{
				stopPreview();
				return;
			}
			if (!unsavedProgress)
			{
				MusicBeatState.switchState(new states.editors.MasterEditorMenu());
				FlxG.sound.playMusic(Paths.music('freakyMenu'));
			}
			else
				openSubState(new HudEditorExitPrompt());
			return;
		}

		if (FlxG.keys.justPressed.F1)
			helpBg.visible = helpTexts.visible = !helpBg.visible;

		// H (solo fuori dai textfield: sopra c'e' gia' il return su PsychUIInputText.focusOn) come F2/F3
		if (#if FLX_DEBUG FlxG.keys.justPressed.F3 #else FlxG.keys.justPressed.F2 #end || FlxG.keys.justPressed.H)
			togglePanels();

		if (FlxG.keys.justPressed.F12)
			showSelectionQuad = !showSelectionQuad;

		if (FlxG.keys.justPressed.T)
			setTweenCaptureMode(!tweenCaptureMode);

		// W / S: elemento precedente / successivo
		if (listRefs.length > 0 && (FlxG.keys.justPressed.W || FlxG.keys.justPressed.S))
		{
			var dir:Int = FlxG.keys.justPressed.W ? -1 : 1;
			var cur:Int = spriteListRadioGroup.checked;
			var next:Int = FlxMath.wrap(cur + dir, 0, listRefs.length - 1);
			listSyncing = true;
			spriteListRadioGroup.checked = next;
			listSyncing = false;
			onListClick();
		}

		updateMouseObjectDrag();

		// Movimento con frecce / tasto destro
		var shiftMult:Float = FlxG.keys.pressed.SHIFT ? 4 : 1;
		var ctrlMult:Float = FlxG.keys.pressed.CONTROL ? 0.2 : 1;
		var moveX:Float = 0;
		var moveY:Float = 0;

		var tp:Bool = (touchPad != null);
		if (FlxG.keys.justPressed.LEFT || (tp && touchPad.buttonLeft.justPressed))
			moveX -= 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.RIGHT || (tp && touchPad.buttonRight.justPressed))
			moveX += 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.UP || (tp && touchPad.buttonUp.justPressed))
			moveY -= 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.DOWN || (tp && touchPad.buttonDown.justPressed))
			moveY += 5 * shiftMult * ctrlMult;

		if (FlxG.mouse.justPressedRight)
			rightAccX = rightAccY = 0;
		if (FlxG.mouse.pressedRight && !rightDownOnUI && (FlxG.mouse.deltaScreenX != 0 || FlxG.mouse.deltaScreenY != 0))
		{
			// pixel dello schermo = pixel del mondo (camHUD ha zoom 1); tengo i decimali
			rightAccX += FlxG.mouse.deltaScreenX * ctrlMult;
			rightAccY += FlxG.mouse.deltaScreenY * ctrlMult;
			var stepX:Float = rightAccX < 0 ? Math.ceil(rightAccX) : Math.floor(rightAccX);
			var stepY:Float = rightAccY < 0 ? Math.ceil(rightAccY) : Math.floor(rightAccY);
			rightAccX -= stepX;
			rightAccY -= stepY;
			moveX += stepX;
			moveY += stepY;
		}

		if (moveX != 0 || moveY != 0)
		{
			var m:EditorMetaSprite = getSelected();
			if (m != null)
			{
				stopPreview();
				moveObjectTo(m, Math.round(m.x + moveX), Math.round(m.y + moveY));
			}
		}
	}

	// Mostra/nasconde i pannelli (Setting/Object/Tween + lista). Sprite e selezione restano visibili.
	function togglePanels()
	{
		UI_box.visible = !UI_box.visible;
		UI_box.active = !UI_box.active;
		spriteList_box.visible = spriteListRadioGroup.visible = UI_box.visible;
		spriteList_box.active = spriteListRadioGroup.active = UI_box.active;
		spriteListRadioGroup.updateRadioItems();
	}

	function moveObjectTo(m:EditorMetaSprite, newX:Float, newY:Float)
	{
		m.x = newX;
		m.y = newY;
		unsavedProgress = true;
		refreshPosUI();
	}

	function isMouseOverUI():Bool
	{
		if (helpBg.visible || pngPickerOpen)
			return true;
		if (UI_box.visible && FlxG.mouse.overlaps(UI_box, camHUD))
			return true;
		if (spriteList_box.visible && FlxG.mouse.overlaps(spriteList_box, camHUD))
			return true;
		return false;
	}

	// Tutti gli elementi sotto il mouse: prima il selezionato, poi i piu' piccoli
	function getObjectsAtMouse():Array<Int>
	{
		var found:Array<{index:Int, area:Float}> = [];
		var px:Float = FlxG.mouse.screenX;
		var py:Float = FlxG.mouse.screenY;
		for (i in 0...items.length)
		{
			var m:EditorMetaSprite = items[i];
			if (m == null || m.sprite == null || !m.sprite.visible)
				continue;
			if (!m.hitTest(px, py, 6))
				continue;
			found.push({index: i, area: m.area()});
		}

		found.sort(function(a, b)
		{
			if (a.index == selectedIdx)
				return -1;
			if (b.index == selectedIdx)
				return 1;
			if (a.area != b.area)
				return a.area < b.area ? -1 : 1;
			return items[b.index].zIndex - items[a.index].zIndex; // a parita' di area vince quello disegnato sopra (zIndex)
		});
		return [for (f in found) f.index];
	}

	function updateMouseObjectDrag()
	{
		// CLICK DESTRO senza trascinare = annulla la cattura, altrimenti deseleziona
		if (FlxG.mouse.justPressedRight)
		{
			rightDownX = FlxG.mouse.screenX;
			rightDownY = FlxG.mouse.screenY;
			rightDownOnUI = isMouseOverUI();
		}
		if (FlxG.mouse.justReleasedRight && !rightDownOnUI)
		{
			var dist:Float = Math.abs(FlxG.mouse.screenX - rightDownX) + Math.abs(FlxG.mouse.screenY - rightDownY);
			if (dist < 4)
			{
				if (tweenCaptureActive)
					cancelTweenCapture();
				else if (selectedIdx >= 0)
					deselectAll();
			}
		}

		var ctrl:Bool = FlxG.keys.pressed.CONTROL;
		if (dragSprite != null)
		{
			if (!ctrl || !FlxG.mouse.pressed)
			{
				dragSprite = null;
				return;
			}

			// posizione assoluta: il punto afferrato resta sotto il cursore
			var newX:Float = Math.round(FlxG.mouse.screenX - dragPosX);
			var newY:Float = Math.round(FlxG.mouse.screenY - dragPosY);
			if (newX != dragSprite.x || newY != dragSprite.y)
			{
				moveObjectTo(dragSprite, newX, newY);
				dragMoved = true;
			}
			return;
		}

		if (ctrl && FlxG.mouse.justPressed && !isMouseOverUI())
		{
			// Ctrl+click durante una cattura = salva il keyframe successivo (B, C, D...) e RESTA in cattura.
			// Il drag riparte da qui, cosi' si puo' trascinare subito verso il keyframe dopo.
			if (tweenCaptureActive)
			{
				addCaptureKeyframe();
				var capTarget:EditorMetaSprite = tweenCaptureTarget;
				if (capTarget != null)
				{
					dragSprite = capTarget;
					dragMoved = false;
					dragPosX = FlxG.mouse.screenX - capTarget.x;
					dragPosY = FlxG.mouse.screenY - capTarget.y;
				}
				return;
			}

			var candidates:Array<Int> = getObjectsAtMouse();
			var target:Int = -1;

			if (candidates.length > 0)
			{
				// stesso punto cliccato di nuovo: passa al prossimo elemento sovrapposto
				var now:Float = haxe.Timer.stamp();
				var sameSpot:Bool = Math.abs(FlxG.mouse.screenX - lastPickX) + Math.abs(FlxG.mouse.screenY - lastPickY) < 6
					&& now - lastPickTime < 2 && !dragMoved;
				pickCycle = sameSpot ? pickCycle + 1 : 0;
				lastPickX = FlxG.mouse.screenX;
				lastPickY = FlxG.mouse.screenY;
				lastPickTime = now;
				target = candidates[pickCycle % candidates.length];
			}
			else if (selectedIdx >= 0)
			{
				// click nel vuoto: muove comunque l'elemento selezionato (movimento relativo)
				target = selectedIdx;
				pickCycle = 0;
				lastPickX = -9999;
			}

			if (target >= 0)
			{
				if (target != selectedIdx)
					selectItem(target);
				stopPreview();
				dragSprite = items[target];
				dragMoved = false;
				dragPosX = FlxG.mouse.screenX - dragSprite.x;
				dragPosY = FlxG.mouse.screenY - dragSprite.y;

				// Ctrl+click in "Tween Capture Mode" = registra A
				if (tweenCaptureMode)
					beginTweenCapture(dragSprite);
			}
		}
	}

	// -------------------------------------------------------------------
	// Draw
	// -------------------------------------------------------------------
	override function draw()
	{
		if (persistentDraw || subState == null)
		{
			for (m in sortedItems())
				if (m.sprite != null && m.sprite.visible)
					m.draw();

			// ghost tratteggiati nelle posizioni dei keyframe gia' catturati (A, B, C...)
			if (tweenCaptureActive && tweenCaptureTarget != null)
			{
				var tm:EditorMetaSprite = tweenCaptureTarget;
				var gr = tm.getRect();
				for (gk in capKeys)
					drawOutline(gr.x + (gk.x - tm.x), gr.y + (gk.y - tm.y), gr.w, gr.h, FlxColor.CYAN, 0.9, 2, true);
				drawOutline(gr.x, gr.y, gr.w, gr.h, FlxColor.YELLOW, 0.9, 2, false);
			}
			else if (showSelectionQuad)
			{
				var sel:EditorMetaSprite = getSelected();
				if (sel != null)
				{
					var r = sel.getRect();
					drawOutline(r.x, r.y, r.w, r.h, FlxColor.LIME, 0.9, 2, false);
				}
			}
		}

		super.draw();
	}

	function drawLine(x:Float, y:Float, w:Float, h:Float, color:FlxColor, alpha:Float)
	{
		linePx.color = color;
		linePx.alpha = alpha;
		linePx.scale.set(Math.max(1, w), Math.max(1, h));
		linePx.updateHitbox();
		linePx.x = x;
		linePx.y = y;
		linePx.draw();
	}

	function drawOutline(x:Float, y:Float, w:Float, h:Float, color:FlxColor, alpha:Float, t:Float, dashed:Bool)
	{
		if (!dashed)
		{
			drawLine(x, y, w, t, color, alpha);
			drawLine(x, y + h - t, w, t, color, alpha);
			drawLine(x, y, t, h, color, alpha);
			drawLine(x + w - t, y, t, h, color, alpha);
			return;
		}

		var dash:Float = 8;
		var gap:Float = 6;
		var cx:Float = x;
		while (cx < x + w)
		{
			var l:Float = Math.min(dash, x + w - cx);
			drawLine(cx, y, l, t, color, alpha);
			drawLine(cx, y + h - t, l, t, color, alpha);
			cx += dash + gap;
		}
		var cy:Float = y;
		while (cy < y + h)
		{
			var l:Float = Math.min(dash, y + h - cy);
			drawLine(x, cy, t, l, color, alpha);
			drawLine(x + w - t, cy, t, l, color, alpha);
			cy += dash + gap;
		}
	}

	override function destroy()
	{
		destroySubStates = true;
		stopPreview();
		clearSaveListeners();
		linePx = FlxDestroyUtil.destroy(linePx);
		super.destroy();
	}
}

// =======================================================================
// Dati del tween: catena ordinata di keyframe (A, B, C...) per target
// =======================================================================
class HudTweenData
{
	public var targetType:String = 'overlay'; // "strum" | "overlay" | "widget"
	public var targetName:String = ''; // "strum_0" | nome overlay | "healthBar" ecc.
	public var targetIndex:Int = -1; // per gli strum: indice in strumLineNotes.members

	public var propX:Bool = true;
	public var propY:Bool = true;
	public var propAlpha:Bool = false;
	public var propAngle:Bool = false;
	public var propScale:Bool = false;

	// Catena ordinata di keyframe (minimo 2). Il segmento i-1 -> i usa duration/easing del keyframe i.
	public var keys:Array<HudKeyframe> = [];

	// Default per i NUOVI segmenti (i valori reali stanno nei keyframe)
	public var duration:Float = 1.0;
	public var delay:Float = 0.0;
	public var easing:String = 'quadInOut';
	public var loop:Bool = false;
	public var yoyo:Bool = false;
	public var trigger:String = 'onBeatHit'; // "onCreatePost" | "onBeatHit" | "onStepHit" | "customFunction"
	public var triggerBeat:Int = 0;
	public var customFuncName:String = ''; // solo se trigger == "customFunction"

	public function new() {}

	// copia le impostazioni (non i valori A/B ne' il target)
	public function copySettingsFrom(o:HudTweenData)
	{
		propX = o.propX;
		propY = o.propY;
		propAlpha = o.propAlpha;
		propAngle = o.propAngle;
		propScale = o.propScale;
		duration = o.duration;
		delay = o.delay;
		easing = o.easing;
		loop = o.loop;
		yoyo = o.yoyo;
		trigger = o.trigger;
		triggerBeat = o.triggerBeat;
		customFuncName = o.customFuncName;
	}
}

// Un keyframe: stato dell'elemento + durata/easing del segmento che ARRIVA a questo keyframe
// (per il primo keyframe, A, duration/easing non sono usati)
class HudKeyframe
{
	public var x:Float = 0;
	public var y:Float = 0;
	public var alpha:Float = 1;
	public var angle:Float = 0;
	public var scale:Float = 1; // scala uniforme (x = y)
	public var duration:Float = 1.0;
	public var easing:String = 'quadInOut';

	public function new() {}
}

// Segmento "piatto" per preview ed export (include i segmenti di ritorno dello yoyo)
typedef HudSeg =
{
	var x:Float;
	var y:Float;
	var alpha:Float;
	var angle:Float;
	var scale:Float;
	var dur:Float;
	var ease:String;
}

typedef HudPngEntry =
{
	var name:String; // percorso relativo a mods/images, senza estensione
	var hasXml:Bool;
}

// =======================================================================
// Wrapper di un elemento dell'HUD (copia-adattato da StageEditorMetaSprite)
// type: "strum" | "healthbar" | "scoreText" | "timeText" | "timeBar" | "combo" | "overlay"
// =======================================================================
class EditorMetaSprite
{
	public var sprite:FlxSprite;
	public var type:String;
	public var name:String;
	public var targetIndex:Int = -1;
	public var isGroup:Bool = false;

	// Draw order GLOBALE: default = ordine di creazione (comportamento invariato)
	public static var zCounter:Int = 0;
	public var zIndex:Int = 0;
	public var defaultZ:Int = 0;

	public var canScale:Bool = true;
	public var canRotate:Bool = true;
	public var canTween:Bool = true;

	public var defaultX:Float = 0;
	public var defaultY:Float = 0;
	public var defaultAlpha:Float = 1;
	public var defaultScaleX:Float = 1;
	public var defaultScaleY:Float = 1;

	public var x(get, set):Float;
	public var y(get, set):Float;
	public var alpha(get, set):Float;
	public var angle(get, set):Float;

	function get_x() return sprite.x;
	function set_x(v:Float) return (sprite.x = v);
	function get_y() return sprite.y;
	function set_y(v:Float) return (sprite.y = v);
	function get_alpha() return sprite.alpha;
	function set_alpha(v:Float) return (sprite.alpha = v);
	function get_angle() return sprite.angle;
	function set_angle(v:Float) return (sprite.angle = v);

	public var scale:Array<Float> = [1, 1];

	// solo overlay
	public var animated:Bool = false;
	public var animations:Array<AnimArray>;
	public var firstAnimation:String;

	public var image(default, set):String = 'unknown';

	function set_image(v:String)
	{
		try
		{
			if (animated)
				sprite.frames = Paths.getAtlas(v);
			else
				sprite.loadGraphic(Paths.image(v));
		}
		catch (e:Dynamic) {}

		if (sprite.graphic == null || sprite.frames == null)
		{
			trace('Could not load image "$v" for overlay "$name"');
			sprite.makeGraphic(200, 200, FlxColor.MAGENTA);
		}
		sprite.updateHitbox();
		return (image = v);
	}

	public var antialiasing(default, set):Bool = true;

	function set_antialiasing(v:Bool)
	{
		sprite.antialiasing = (v && ClientPrefs.data.antialiasing);
		return (antialiasing = v);
	}

	public var flipX(get, set):Bool;
	public var flipY(get, set):Bool;

	function get_flipX() return sprite.flipX;
	function set_flipX(v:Bool) return (sprite.flipX = v);
	function get_flipY() return sprite.flipY;
	function set_flipY(v:Bool) return (sprite.flipY = v);

	// Per overlay (scaleObject di Psych fa updateHitbox) -> updHitbox = true.
	// Per i widget nativi il gioco usa setProperty('x.scale.x') SENZA updateHitbox -> false,
	// cosi' x/y significano la stessa cosa nell'editor e in gioco.
	public function setScale(wid:Null<Float> = null, hei:Null<Float> = null, updHitbox:Bool = false)
	{
		scale[0] = (wid != null ? wid : scale[0]);
		scale[1] = (hei != null ? hei : scale[1]);
		sprite.scale.set(scale[0], scale[1]);
		if (updHitbox)
			sprite.updateHitbox();
	}

	public function new(type:String, name:String, spr:FlxSprite, isGroup:Bool = false)
	{
		this.type = type;
		this.name = name;
		this.sprite = spr;
		this.isGroup = isGroup;
		this.zIndex = this.defaultZ = zCounter++;

		switch (type)
		{
			case 'healthbar', 'timeBar':
				canScale = false;
				canRotate = false;
			case 'combo':
				canScale = false;
				canRotate = false;
				canTween = false;
		}
		scale = [spr.scale.x, spr.scale.y];
		defaultScaleX = scale[0];
		defaultScaleY = scale[1];
	}

	public function tweenKind():String
		return (type == 'strum') ? 'strum' : (type == 'overlay' ? 'overlay' : 'widget');

	// Rettangolo (asse-allineato) occupato dall'elemento, in coordinate schermo
	public function getRect():{x:Float, y:Float, w:Float, h:Float}
	{
		var s:FlxSprite = sprite;
		if (isGroup)
			return {x: s.x, y: s.y, w: s.width, h: s.height};

		var w:Float = Math.abs(s.frameWidth * s.scale.x);
		var h:Float = Math.abs(s.frameHeight * s.scale.y);
		var pivotX:Float = s.x - s.offset.x + s.origin.x;
		var pivotY:Float = s.y - s.offset.y + s.origin.y;
		var left:Float = pivotX - s.origin.x * s.scale.x;
		var top:Float = pivotY - s.origin.y * s.scale.y;
		if (s.scale.x < 0)
			left -= w;
		if (s.scale.y < 0)
			top -= h;
		return {x: left, y: top, w: w, h: h};
	}

	public function area():Float
	{
		var r = getRect();
		return r.w * r.h;
	}

	// Hit test con rotazione e tolleranza (pad)
	public function hitTest(wx:Float, wy:Float, pad:Float):Bool
	{
		var s:FlxSprite = sprite;
		var px:Float = wx;
		var py:Float = wy;

		if (!isGroup && s.angle != 0)
		{
			var pivotX:Float = s.x - s.offset.x + s.origin.x;
			var pivotY:Float = s.y - s.offset.y + s.origin.y;
			var rad:Float = -s.angle * Math.PI / 180;
			var dx:Float = wx - pivotX;
			var dy:Float = wy - pivotY;
			px = pivotX + dx * Math.cos(rad) - dy * Math.sin(rad);
			py = pivotY + dx * Math.sin(rad) + dy * Math.cos(rad);
		}

		var r = getRect();
		return px >= r.x - pad && px <= r.x + r.w + pad && py >= r.y - pad && py <= r.y + r.h + pad;
	}

	public function update(elapsed:Float)
		sprite.update(elapsed);

	public function draw()
		sprite.draw();
}

class HudEditorExitPrompt extends MusicBeatSubstate
{
	public function new()
	{
		super();
		var bg:FlxSprite = new FlxSprite().makeGraphic(1, 1, FlxColor.BLACK);
		bg.scale.set(FlxG.width, FlxG.height);
		bg.updateHitbox();
		bg.alpha = 0.6;
		add(bg);

		var txt:FlxText = new FlxText(0, FlxG.height / 2 - 60, FlxG.width, "Unsaved progress!\nAre you sure you want to exit?", 24);
		txt.setFormat(null, 24, FlxColor.WHITE, CENTER, OUTLINE_FAST, FlxColor.BLACK);
		txt.borderSize = 1;
		add(txt);

		var btnYes:PsychUIButton = new PsychUIButton(FlxG.width / 2 - 110, FlxG.height / 2 + 20, 'Yes', function()
		{
			close();
			new FlxTimer().start(0.01, function(_)
			{
				MusicBeatState.switchState(new states.editors.MasterEditorMenu());
			});
		});
		btnYes.normalStyle.bgColor = FlxColor.RED;
		btnYes.normalStyle.textColor = FlxColor.WHITE;
		add(btnYes);

		var btnNo:PsychUIButton = new PsychUIButton(FlxG.width / 2 + 10, FlxG.height / 2 + 20, 'No', function()
		{
			close();
		});
		add(btnNo);
	}
}

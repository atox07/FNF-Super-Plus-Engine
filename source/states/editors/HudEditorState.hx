	function refreshTweenUI()
	{
		var wasUpdating:Bool = uiUpdating;
		uiUpdating = true;
		var m:EditorMetaSprite = getSelected();
		var t:HudTweenData = activeTweenData();
		var has:Bool = (tweenForTarget(m) != null);

		tweenTargetTxt.text = 'Target: ' + (m != null ? m.name : '(nothing selected)') + (has ? '  [has tween]' : '');
		tPropX.checked = t.propX;
		tPropY.checked = t.propY;
		tPropAlpha.checked = t.propAlpha;
		tPropAngle.checked = t.propAngle;
		tPropScale.checked = t.propScale;
		tDuration.value = t.duration;
		tDelay.value = t.delay;
		tLoop.checked = t.loop;
		tYoyo.checked = t.yoyo;
		tBeat.value = t.triggerBeat;
		tFuncInput.text = t.customFuncName;
		tEasingDD.selectedLabel = t.easing;
		tTriggerDD.selectedLabel = t.trigger;
		tModeCheckbox.checked = tweenCaptureMode;
		tCaptureButton.label = tweenCaptureActive ? 'Finish Chain' : 'Capture Chain';
		var frames = tweenCaptureActive ? captureKeyframes : ((t.keyframes != null) ? t.keyframes : []);
		tweenFramesTxt.text = 'Keyframes: ' + (frames.length > 0 ? [for (i in 0...frames.length) String.fromCharCode(65 + i) + ':(' + Math.round(frames[i].x) + ',' + Math.round(frames[i].y) + ') ' + frames[i].duration + 's/' + frames[i].easing].join('  ') : (tweenCaptureActive ? 'capturing ' + captureKeyframes.length : 'none'));
		uiUpdating = wasUpdating;
	}

	function setTweenCaptureMode(on:Bool)
	{
		tweenCaptureMode = on;
		if (!on && tweenCaptureActive)
			cancelTweenCapture();
		showOutput(on ? 'Tween Capture Mode ON: Ctrl+Click = A, Ctrl+Click again = B' : 'Tween Capture Mode OFF: Ctrl+Drag moves statically');
		refreshTweenUI();
	}

	// -------------------------------------------------------------------
	// Cattura tween
	// -------------------------------------------------------------------
	function indexOfTarget(t:HudTweenData):Int
	{
		for (i in 0...items.length)
		{
			var m:EditorMetaSprite = items[i];
			if (m.tweenKind() != t.targetType)
				continue;
			if (t.targetType == 'strum')
			{
				if (m.targetIndex == t.targetIndex)
					return i;
			}
			else if (m.name == t.targetName)
				return i;
		}
		return -1;
	}

	function tweenForTarget(m:EditorMetaSprite):HudTweenData
	{
		if (m == null)
			return null;
		for (t in hudTweens)
			if (indexOfTarget(t) >= 0 && items[indexOfTarget(t)] == m)
				return t;
		return null;
	}

	function beginTweenCapture(m:EditorMetaSprite)
	{
		if (m == null)
			return;
		if (!m.canTween)
		{
			showOutput('"${m.name}" supports only a static position (no tween).', true);
			return;
		}
		stopPreview();
		tweenCaptureTarget = m;
		captureKeyframes = [];
		tweenCaptureFromX = m.x;
		tweenCaptureFromY = m.y;
		capFromAlpha = m.alpha;
		capFromAngle = m.angle;
		capFromScaleX = m.scale[0];
		capFromScaleY = m.scale[1];
		tweenCaptureActive = true;
		var firstKf = new HudTweenKeyframe(m.x, m.y, m.alpha, m.angle, m.scale[0], m.scale[1]);
		firstKf.duration = tweenTemplate.duration; firstKf.easing = tweenTemplate.easing;
		captureKeyframes.push(firstKf);
		showOutput('Point A saved for "${m.name}". Move it, then Ctrl+Click (or the button) for point B.');
		refreshTweenUI();
	}

	function onCaptureButton()
	{
		if (tweenCaptureActive)
		{
			finishTweenCapture();
			return;
		}
		var m:EditorMetaSprite = getSelected();
		if (m == null)
		{
			showOutput('Select an element first.', true);
			return;
		}
		beginTweenCapture(m);
	}

	// Riporta il target ai valori di A
	function revertCapture(m:EditorMetaSprite)
	{
		m.x = tweenCaptureFromX;
		m.y = tweenCaptureFromY;
		m.alpha = capFromAlpha;
		if (m.canRotate)
			m.angle = capFromAngle;
		if (m.canScale)
			m.setScale(capFromScaleX, capFromScaleY, m.type == 'overlay');
	}

	function cancelTweenCapture()
	{
		if (!tweenCaptureActive)
			return;
		if (tweenCaptureTarget != null)
			revertCapture(tweenCaptureTarget);
		tweenCaptureActive = false;
		tweenCaptureTarget = null;
		captureKeyframes = [];
		dragSprite = null;
		showOutput('Tween capture cancelled.');
		updateSelectedUI();
	}

	function finishTweenCapture()
	{
		if (!tweenCaptureActive || tweenCaptureTarget == null) return;
		var m = tweenCaptureTarget;
		var last = new HudTweenKeyframe(m.x, m.y, m.alpha, m.angle, m.scale[0], m.scale[1]);
		last.duration = tweenTemplate.duration; last.easing = tweenTemplate.easing;
		if (captureKeyframes.length == 0 || !captureKeyframes[captureKeyframes.length - 1].sameAs(last))
			captureKeyframes.push(last);
		if (captureKeyframes.length < 2)
		{
			showOutput('Add at least one point after A before finishing.', true);
			return;
		}
		var t = new HudTweenData();
		t.copySettingsFrom(tweenTemplate);
		t.targetType = m.tweenKind();
		t.targetName = m.name;
		t.targetIndex = m.targetIndex;
		t.keyframes = captureKeyframes.copy();
		var a = t.keyframes[0];
		var b = t.keyframes[1];
		t.fromX=a.x; t.fromY=a.y; t.toX=b.x; t.toY=b.y;
		t.fromAlpha=a.alpha; t.toAlpha=b.alpha; t.fromAngle=a.angle; t.toAngle=b.angle;
		t.fromScale=a.scaleX; t.toScale=b.scaleX;
		t.propX = t.keyframes.length > 1 && t.keyframes.exists(k -> differs(k.x, a.x));
		t.propY = t.keyframes.length > 1 && t.keyframes.exists(k -> differs(k.y, a.y));
		t.propAlpha = t.keyframes.exists(k -> differs(k.alpha, a.alpha));
		t.propAngle = t.keyframes.exists(k -> differs(k.angle, a.angle));
		t.propScale = t.keyframes.exists(k -> differs(k.scaleX, a.scaleX) || differs(k.scaleY, a.scaleY));
		var existing = tweenForTarget(m);
		if (existing != null)
		{
			askConfirm('"${m.name}" already has a tween.\\nReplace it?', function() commitTween(t, existing, m), function() cancelTweenCapture());
			return;
		}
		commitTween(t, null, m);
	}

	function commitTween(t:HudTweenData, existing:HudTweenData, m:EditorMetaSprite)
	{
		if (existing != null)
			hudTweens.remove(existing);
		hudTweens.push(t);

		// il tween e' un DATO: l'elemento torna alla posizione A
		var first = t.keyframes[0];
		m.x = first.x; m.y = first.y; m.alpha = first.alpha; m.angle = first.angle;
		if (m.canScale) m.setScale(first.scaleX, first.scaleY, m.type == 'overlay');
		tweenCaptureActive = false;
		captureKeyframes = [];
		tweenCaptureTarget = null;
		dragSprite = null;
		unsavedProgress = true;
		refreshList();
		updateSelectedUI();
		showOutput('Tween created for "${m.name}". The element is back at point A.');
	}

	// -------------------------------------------------------------------
	// Preview del tween (FlxTween in editor; poi l'elemento torna com'era)
	// -------------------------------------------------------------------
	public static function easeByName(n:String):Float->Float
	{
		return switch (n)
		{
			case 'quadIn': FlxEase.quadIn;
			case 'quadOut': FlxEase.quadOut;
			case 'quadInOut': FlxEase.quadInOut;
			case 'cubeIn': FlxEase.cubeIn;
			case 'cubeOut': FlxEase.cubeOut;
			case 'cubeInOut': FlxEase.cubeInOut;
			case 'quartIn': FlxEase.quartIn;
			case 'quartOut': FlxEase.quartOut;
			case 'quartInOut': FlxEase.quartInOut;
			case 'quintIn': FlxEase.quintIn;
			case 'quintOut': FlxEase.quintOut;
			case 'quintInOut': FlxEase.quintInOut;
			case 'sineIn': FlxEase.sineIn;
			case 'sineOut': FlxEase.sineOut;
			case 'sineInOut': FlxEase.sineInOut;
			case 'bounceIn': FlxEase.bounceIn;
			case 'bounceOut': FlxEase.bounceOut;
			case 'bounceInOut': FlxEase.bounceInOut;
			case 'circIn': FlxEase.circIn;
			case 'circOut': FlxEase.circOut;
			case 'circInOut': FlxEase.circInOut;
			case 'expoIn': FlxEase.expoIn;
			case 'expoOut': FlxEase.expoOut;
			case 'expoInOut': FlxEase.expoInOut;
			case 'smoothStepIn': FlxEase.smoothStepIn;
			case 'smoothStepOut': FlxEase.smoothStepOut;
			case 'smoothStepInOut': FlxEase.smoothStepInOut;
			case 'elasticIn': FlxEase.elasticIn;
			case 'elasticOut': FlxEase.elasticOut;
			case 'elasticInOut': FlxEase.elasticInOut;
			case 'backIn': FlxEase.backIn;
			case 'backOut': FlxEase.backOut;
			case 'backInOut': FlxEase.backInOut;
			default: FlxEase.linear;
		}
	}

	function startPreview(t:HudTweenData)
	{
		var idx:Int = indexOfTarget(t);
		if (idx < 0)
		{
			showOutput('Tween target not found.', true);
			return;
		}
		stopPreview();

		var m:EditorMetaSprite = items[idx];
		var s:FlxSprite = m.sprite;
		previewMeta = m;
		prevX = m.x;
		prevY = m.y;
		prevAlpha = m.alpha;
		prevAngle = m.angle;
		prevScaleX = m.scale[0];
		prevScaleY = m.scale[1];

		if (t.keyframes != null && t.keyframes.length > 1)
		{
			var first = t.keyframes[0];
			s.x = first.x; s.y = first.y; s.alpha = first.alpha; s.angle = first.angle;
			s.scale.set(first.scaleX, first.scaleY);
			var cumulative:Float = t.delay;
			for (i in 0...(t.keyframes.length - 1))
			{
				var k = t.keyframes[i + 1];
				var duration = k.duration > 0 ? k.duration : t.duration;
				var values:Dynamic = {};
				if (t.propX) Reflect.setField(values, 'x', k.x);
				if (t.propY) Reflect.setField(values, 'y', k.y);
				if (t.propAlpha) Reflect.setField(values, 'alpha', k.alpha);
				if (t.propAngle && m.canRotate) Reflect.setField(values, 'angle', k.angle);
				previewTweens.push(FlxTween.tween(s, values, duration, {ease: easeByName(k.easing), startDelay: cumulative}));
				if (t.propScale && m.canScale)
					previewTweens.push(FlxTween.tween(s.scale, {x: k.scaleX, y: k.scaleY}, duration, {ease: easeByName(k.easing), startDelay: cumulative}));
				cumulative += duration;
			}
			previewRestoreTimer = cumulative + 0.6;
			return;
		}

		// parte da A
		if (t.propX)
			s.x = t.fromX;
		if (t.propY)
			s.y = t.fromY;
		if (t.propAlpha)
			s.alpha = t.fromAlpha;
		if (t.propAngle && m.canRotate)
			s.angle = t.fromAngle;
		if (t.propScale && m.canScale)
			s.scale.set(t.fromScale, t.fromScale);

		// 4 = PINGPONG, 2 = LOOPING, 8 = ONESHOT (valori di FlxTweenType)
		var type:Int = t.yoyo ? 4 : (t.loop ? 2 : 8);
		function makeOpts(isMain:Bool):Dynamic
		{
			return {
				ease: easeByName(t.easing),
				startDelay: t.delay,
				type: type,
				onComplete: function(_:FlxTween)
				{
					if (isMain && type == 8)
						previewRestoreTimer = 0.6; // lascio vedere lo stato finale e poi ripristino
				}
			};
		}

		var vals:Dynamic = {};
		var has:Bool = false;
		if (t.propX)
		{
			Reflect.setField(vals, 'x', t.toX);
			has = true;
		}
		if (t.propY)
		{
			Reflect.setField(vals, 'y', t.toY);
			has = true;
		}
		if (t.propAlpha)
		{
			Reflect.setField(vals, 'alpha', t.toAlpha);
			has = true;
		}
		if (t.propAngle && m.canRotate)
		{
			Reflect.setField(vals, 'angle', t.toAngle);
			has = true;
		}
		if (has)
			previewTweens.push(FlxTween.tween(s, vals, t.duration, makeOpts(true)));

		if (t.propScale && m.canScale)
			previewTweens.push(FlxTween.tween(s.scale, {x: t.toScale, y: t.toScale}, t.duration, makeOpts(!has)));
	}

	function stopPreview()
	{
		for (tw in previewTweens)
			if (tw != null)
				tw.cancel();
		previewTweens = [];
		previewRestoreTimer = -1;

		if (previewMeta != null)
		{
			var m:EditorMetaSprite = previewMeta;
			m.x = prevX;
			m.y = prevY;
			m.alpha = prevAlpha;
			if (m.canRotate)
				m.angle = prevAngle;
			if (m.canScale)
				m.setScale(prevScaleX, prevScaleY, m.type == 'overlay');
			previewMeta = null;
		}
	}

	// -------------------------------------------------------------------
	// Overlay (PNG importati)
	// -------------------------------------------------------------------
	function createOverlay(imageName:String, anims:Array<AnimArray>, animated:Bool):EditorMetaSprite
	{
		var spr:ModchartSprite = new ModchartSprite();
		spr.scrollFactor.set(0, 0);
		var baseName:String = imageName.substring(imageName.lastIndexOf('/') + 1);
		var m:EditorMetaSprite = new EditorMetaSprite('overlay', findUnoccupiedName(baseName), spr);
		m.animated = animated;
		m.animations = anims;
		m.firstAnimation = (anims != null && anims.length > 0) ? anims[0].anim : null;
		m.image = imageName; // carica il grafico (con fallback magenta)

		if (animated && anims != null)
		{
			for (anim in anims)
				spr.animation.addByPrefix(anim.anim, anim.name, anim.fps, anim.loop);
			if (m.firstAnimation != null)
				spr.animation.play(m.firstAnimation, true);
		}

		spr.x = Math.round((FlxG.width - spr.width) / 2);
		spr.y = Math.round((FlxG.height - spr.height) / 2);
		return m;
	}

	// ---------------------------------------------------------------
	// PNG picker: legge mods/images (e sottocartelle), solo PNG oppure PNG + XML
	// (copiato da StageEditorState; PngEntry -> HudPngEntry per evitare il
	//  conflitto di nome nello stesso package)
	// ---------------------------------------------------------------
	static inline var PNG_DIR:String = 'mods/images/';
	static inline var PNG_PICKER_W:Int = 560;
	static inline var PNG_ROWS:Int = 16;
	static inline var PNG_ROW_H:Int = 20;

	var pngPickerGroup:FlxSpriteGroup;
	var pngPickerOpen:Bool = false;
	var pngEntries:Array<HudPngEntry> = [];
	var pngScroll:Int = 0;
	var pngRows:Array<FlxText> = [];
	var pngHoverRect:FlxSprite;
	var pngInfoText:FlxText;
	var pngPanelX:Float = 0;
	var pngPanelY:Float = 0;
	var pngPanelH:Float = 0;

	function makePngRect(x:Float, y:Float, w:Float, h:Float, color:FlxColor, alpha:Float = 1):FlxSprite
	{
		var spr:FlxSprite = new FlxSprite(x, y).makeGraphic(1, 1, color);
		spr.scale.set(w, h);
		spr.updateHitbox();
		spr.x = x;
		spr.y = y;
		spr.alpha = alpha;
		spr.scrollFactor.set();
		return spr;
	}

	function makePngText(x:Float, y:Float, w:Float, text:String, size:Int = 14, color:FlxColor = FlxColor.WHITE):FlxText
	{
		var t:FlxText = new FlxText(x, y, w, text, size);
		t.color = color;
		t.scrollFactor.set();
		return t;
	}

	function scanPngFolder(folder:String, prefix:String, found:Array<HudPngEntry>, depth:Int)
	{
		#if sys
		if (depth > 8 || !FileSystem.exists(folder) || !FileSystem.isDirectory(folder))
			return;

		for (file in FileSystem.readDirectory(folder))
		{
			var full:String = folder + file;
			if (FileSystem.isDirectory(full))
			{
				scanPngFolder(full + '/', prefix + file + '/', found, depth + 1);
				continue;
			}

			if (!file.toLowerCase().endsWith('.png'))
				continue;

			var baseName:String = file.substr(0, file.length - 4);
			found.push({name: prefix + baseName, hasXml: FileSystem.exists(folder + baseName + '.xml')});
		}
		#end
	}

	function openPngPicker()
	{
		pngEntries = [];
		scanPngFolder(PNG_DIR, '', pngEntries, 0);
		pngEntries.sort(function(a:HudPngEntry, b:HudPngEntry):Int
		{
			var ak:String = a.name.toLowerCase();
			var bk:String = b.name.toLowerCase();
			return ak < bk ? -1 : (ak > bk ? 1 : 0);
		});
		pngScroll = 0;

		if (pngPickerGroup == null)
			buildPngPicker();

		pngInfoText.text = (pngEntries.length > 0) ? '${pngEntries.length} PNG in $PNG_DIR' : 'No PNG found in $PNG_DIR';
		refreshPngRows();
		pngPickerGroup.visible = pngPickerGroup.active = pngPickerOpen = true;
	}

	function closePngPicker()
	{
		pngPickerOpen = false;
		if (pngPickerGroup != null)
			pngPickerGroup.visible = pngPickerGroup.active = false;
	}

	function buildPngPicker()
	{
		pngPanelH = 70 + PNG_ROWS * PNG_ROW_H + 40;
		pngPanelX = Math.round((FlxG.width - PNG_PICKER_W) / 2);
		pngPanelY = Math.round((FlxG.height - pngPanelH) / 2);

		pngPickerGroup = new FlxSpriteGroup();
		pngPickerGroup.cameras = [camHUD];
		pngPickerGroup.scrollFactor.set();

		pngPickerGroup.add(makePngRect(0, 0, FlxG.width, FlxG.height, FlxColor.BLACK, 0.7));
		pngPickerGroup.add(makePngRect(pngPanelX - 2, pngPanelY - 2, PNG_PICKER_W + 4, pngPanelH + 4, FlxColor.WHITE, 0.9));
		pngPickerGroup.add(makePngRect(pngPanelX, pngPanelY, PNG_PICKER_W, pngPanelH, 0xFF1E1E26));

		pngPickerGroup.add(makePngText(pngPanelX + 16, pngPanelY + 12, PNG_PICKER_W - 32, 'Import PNG (overlay)', 20));
		pngInfoText = makePngText(pngPanelX + 16, pngPanelY + 42, PNG_PICKER_W - 32, '', 12, 0xFFB0B0B0);
		pngPickerGroup.add(pngInfoText);

		pngHoverRect = makePngRect(pngPanelX + 8, pngPanelY + 70, PNG_PICKER_W - 16, PNG_ROW_H, 0xFF3A5A9A, 0.8);
		pngHoverRect.visible = false;
		pngPickerGroup.add(pngHoverRect);

		pngRows = [];
		for (i in 0...PNG_ROWS)
		{
			var row:FlxText = makePngText(pngPanelX + 18, pngPanelY + 72 + i * PNG_ROW_H, PNG_PICKER_W - 36, '', 14);
			pngRows.push(row);
			pngPickerGroup.add(row);
		}

		pngPickerGroup.add(makePngText(pngPanelX + 16, pngPanelY + 70 + PNG_ROWS * PNG_ROW_H + 10, PNG_PICKER_W - 32,
			'Click = import  |  Wheel / PageUp / PageDown = scroll  |  ESC / right click = close', 12, 0xFFE0E0E0));

		add(pngPickerGroup);
		pngPickerGroup.visible = pngPickerGroup.active = false;
	}

	function refreshPngRows()
	{
		var maxScroll:Int = Std.int(Math.max(0, pngEntries.length - PNG_ROWS));
		pngScroll = Std.int(FlxMath.bound(pngScroll, 0, maxScroll));

		for (i in 0...PNG_ROWS)
		{
			var row:FlxText = pngRows[i];
			var idx:Int = pngScroll + i;
			if (idx < pngEntries.length)
			{
				var e:HudPngEntry = pngEntries[idx];
				row.text = e.name + (e.hasXml ? '   [PNG + XML]' : '   [PNG]');
				row.color = e.hasXml ? 0xFF8CFF9C : FlxColor.WHITE;
			}
			else
				row.text = '';
		}
	}

	// Gestisce l'input del picker (modale). Ritorna true se il picker e' aperto.
	function updatePngPicker():Bool
	{
		if (!pngPickerOpen)
			return false;

		if (FlxG.keys.justPressed.ESCAPE || FlxG.mouse.justPressedRight)
		{
			closePngPicker();
			return true;
		}

		if (FlxG.mouse.wheel != 0)
		{
			pngScroll -= FlxG.mouse.wheel * 3;
			refreshPngRows();
		}
		if (FlxG.keys.justPressed.PAGEUP)
		{
			pngScroll -= PNG_ROWS;
			refreshPngRows();
		}
		if (FlxG.keys.justPressed.PAGEDOWN)
		{
			pngScroll += PNG_ROWS;
			refreshPngRows();
		}

		FlxG.mouse.getScreenPosition(camHUD, _mousePoint);
		var mx:Float = _mousePoint.x;
		var my:Float = _mousePoint.y;

		var listX:Float = pngPanelX + 8;
		var listY:Float = pngPanelY + 70;
		var overList:Bool = (mx >= listX && mx < listX + PNG_PICKER_W - 16 && my >= listY && my < listY + PNG_ROWS * PNG_ROW_H);
		var hoverIdx:Int = -1;
		if (overList)
		{
			var row:Int = Std.int((my - listY) / PNG_ROW_H);
			if (pngScroll + row < pngEntries.length)
				hoverIdx = pngScroll + row;
		}

		pngHoverRect.visible = (hoverIdx >= 0);
		if (hoverIdx >= 0)
			pngHoverRect.y = listY + (hoverIdx - pngScroll) * PNG_ROW_H;

		if (FlxG.mouse.justPressed)
		{
			if (hoverIdx >= 0)
				importPngEntry(pngEntries[hoverIdx]);
			else if (mx < pngPanelX || mx > pngPanelX + PNG_PICKER_W || my < pngPanelY || my > pngPanelY + pngPanelH)
				closePngPicker();
		}
		return true;
	}

	// Legge le animazioni da un XML Sparrow: una anim per prefisso
	// (il nome del SubTexture senza il numero di frame finale).
	function readXmlAnimations(xmlPath:String):Array<AnimArray>
	{
		var result:Array<AnimArray> = [];
		#if sys
		try
		{
			var root:Xml = Xml.parse(sys.io.File.getContent(xmlPath)).firstElement();
			if (root == null)
				return result;

			var frameNum:EReg = ~/[0-9]+$/;
			var seen:Map<String, Bool> = new Map();
			for (sub in root.elementsNamed('SubTexture'))
			{
				var frameName:String = sub.get('name');
				if (frameName == null)
					continue;

				var prefix:String = frameNum.replace(frameName, '');
				if (prefix.length < 1)
					prefix = frameName;
				if (seen.exists(prefix))
					continue;

				seen.set(prefix, true);
				result.push({
					anim: prefix,
					name: prefix,
					fps: 24,
					loop: false,
					indices: [],
					offsets: [0, 0]
				});
			}
		}
		catch (e:Dynamic)
		{
			trace('Could not read XML "$xmlPath": $e');
		}
		#end
		return result;
	}

	function importPngEntry(entry:HudPngEntry)
	{
		var anims:Array<AnimArray> = entry.hasXml ? readXmlAnimations('$PNG_DIR${entry.name}.xml') : [];
		var animated:Bool = (anims.length > 0);

		var m:EditorMetaSprite = createOverlay(entry.name, anims, animated);
		m.zIndex = items.length;
		items.push(m);
		closePngPicker();

		selectedIdx = items.length - 1;
		refreshList();
		UI_box.selectedName = 'Object';
		updateSelectedUI();
		unsavedProgress = true;
		showOutput('Imported "${entry.name}"' + (animated ? ' (${anims.length} animations from XML)' : ''));
	}

	// -------------------------------------------------------------------
	// Popup di conferma (usato da "Reset All" e da "Replace?")
	// -------------------------------------------------------------------
	var confirmGroup:FlxSpriteGroup;
	var confirmText:FlxText;
	var confirmOpen:Bool = false;
	var confirmYes:Void->Void = null;
	var confirmNo:Void->Void = null;

	function buildConfirmPopup()
	{
		confirmGroup = new FlxSpriteGroup();
		confirmGroup.cameras = [camHUD];
		confirmGroup.scrollFactor.set();

		confirmGroup.add(makePngRect(0, 0, FlxG.width, FlxG.height, FlxColor.BLACK, 0.6));
		confirmGroup.add(makePngRect(FlxG.width / 2 - 232, FlxG.height / 2 - 92, 464, 184, FlxColor.WHITE, 0.9));
		confirmGroup.add(makePngRect(FlxG.width / 2 - 230, FlxG.height / 2 - 90, 460, 180, 0xFF1E1E26));

		confirmText = makePngText(FlxG.width / 2 - 215, FlxG.height / 2 - 75, 430, '', 18);
		confirmText.alignment = CENTER;
		confirmGroup.add(confirmText);

		var yes:PsychUIButton = new PsychUIButton(FlxG.width / 2 - 100, FlxG.height / 2 + 40, 'Yes', function()
		{
			var cb:Void->Void = confirmYes;
			closeConfirm();
			if (cb != null)
				cb();
		});
		yes.normalStyle.bgColor = FlxColor.RED;
		yes.normalStyle.textColor = FlxColor.WHITE;
		confirmGroup.add(yes);

		var no:PsychUIButton = new PsychUIButton(FlxG.width / 2 + 20, FlxG.height / 2 + 40, 'No', function()
		{
			var cb:Void->Void = confirmNo;
			closeConfirm();
			if (cb != null)
				cb();
		});
		confirmGroup.add(no);

		add(confirmGroup);
		confirmGroup.visible = confirmGroup.active = false;
	}

	function askConfirm(text:String, onYes:Void->Void, ?onNo:Void->Void)
	{
		confirmText.text = text;
		confirmYes = onYes;
		confirmNo = onNo;
		confirmGroup.visible = confirmGroup.active = confirmOpen = true;
	}

	function closeConfirm()
	{
		confirmGroup.visible = confirmGroup.active = confirmOpen = false;
		confirmYes = confirmNo = null;
	}

	function updateConfirm(elapsed:Float)
	{
		confirmGroup.update(elapsed);
		if (FlxG.keys.justPressed.ESCAPE)
		{
			var cb:Void->Void = confirmNo;
			closeConfirm();
			if (cb != null)
				cb();
		}
	}

	function resetAll()
	{
		stopPreview();
		tweenCaptureActive = false;
		tweenCaptureTarget = null;
		dragSprite = null;

		for (m in items)
			m.sprite = FlxDestroyUtil.destroy(m.sprite);
		items = [];
		hudTweens = [];
		selectedIdx = -1;
		tweenTemplate = new HudTweenData();

		buildTemplate();
		refreshList();
		updateSelectedUI();
		unsavedProgress = false;
		showOutput('Everything reset to default.');
	}

	// -------------------------------------------------------------------
	// Pannello di export (snippet scrollabile + clipboard + "Salva come file")
	// -------------------------------------------------------------------
	static inline var EXPORT_LINES:Int = 30;

	var exportGroup:FlxSpriteGroup;
	var exportText:FlxText;
	var exportInfo:FlxText;
	var exportLines:Array<String> = [];
	var exportScroll:Int = 0;
	var exportOpen:Bool = false;
	var exportLua:String = '';

	function buildExportPanel()
	{
		var px:Float = 90;
		var py:Float = 20;
		var pw:Float = 1100;
		var ph:Float = 680;

		exportGroup = new FlxSpriteGroup();
		exportGroup.cameras = [camHUD];
		exportGroup.scrollFactor.set();

		exportGroup.add(makePngRect(0, 0, FlxG.width, FlxG.height, FlxColor.BLACK, 0.75));
		exportGroup.add(makePngRect(px - 2, py - 2, pw + 4, ph + 4, FlxColor.WHITE, 0.9));
		exportGroup.add(makePngRect(px, py, pw, ph, 0xFF1E1E26));

		exportGroup.add(makePngText(px + 20, py + 10, pw - 40, 'Export Lua (snippet)', 20));
		exportInfo = makePngText(px + 20, py + 38, pw - 40, '', 12, 0xFFB0B0B0);
		exportGroup.add(exportInfo);

		exportText = new FlxText(px + 20, py + 80, pw - 40, '', 14);
		exportText.setFormat(Paths.font('vcr.ttf'), 14, FlxColor.WHITE, LEFT);
		exportText.wordWrap = false;
		exportText.scrollFactor.set();
		exportGroup.add(exportText);

		var by:Float = py + ph - 40;
		var copyBtn:PsychUIButton = new PsychUIButton(px + 20, by, 'Copy', function()
		{
			copyToClipboard();
		});
		exportGroup.add(copyBtn);

		var saveBtn:PsychUIButton = new PsychUIButton(px + 120, by, 'Save as file', function()
		{
			saveLuaFile();
		}, 110);
		saveBtn.normalStyle.bgColor = FlxColor.GREEN;
		saveBtn.normalStyle.textColor = FlxColor.WHITE;
		exportGroup.add(saveBtn);

		var closeBtn:PsychUIButton = new PsychUIButton(px + 250, by, 'Close', function()
		{
			closeExportPanel();
		});
		exportGroup.add(closeBtn);

		exportGroup.add(makePngText(px + 380, by + 3, 650, 'Wheel / PageUp / PageDown = scroll  |  ESC = close', 12, 0xFFE0E0E0));

		add(exportGroup);
		exportGroup.visible = exportGroup.active = false;
	}

	function copyToClipboard():Bool
	{
		try
		{
			Clipboard.text = exportLua;
			showOutput('Snippet copied to the clipboard.');
			return true;
		}
		catch (e:Dynamic)
		{
			showOutput('Clipboard not available here: use "Save as file".', true);
		}
		return false;
	}

	function openExportPanel()
	{
		stopPreview();
		if (tweenCaptureActive)
			cancelTweenCapture();

		exportLua = generateLua();
		exportLines = exportLua.replace('\t', '    ').split('\n');
		exportScroll = 0;

		var song:String = currentSongName();
		var copied:Bool = true;
		try
		{
			Clipboard.text = exportLua;
		}
		catch (e:Dynamic)
		{
			copied = false;
		}
		exportInfo.text = (copied ? 'Already copied to the clipboard. ' : 'Clipboard not available. ')
			+ 'Paste it into your song lua. "Save as file" writes ${song}_hud.lua: if you put it in data/songs/$song/ Psych loads it by itself '
			+ '(do NOT also call addLuaScript).';
		refreshExportText();
		exportGroup.visible = exportGroup.active = exportOpen = true;
	}

	function closeExportPanel()
	{
		exportGroup.visible = exportGroup.active = exportOpen = false;
	}

	function refreshExportText()
	{
		var maxScroll:Int = Std.int(Math.max(0, exportLines.length - EXPORT_LINES));
		exportScroll = Std.int(FlxMath.bound(exportScroll, 0, maxScroll));
		var shown:Array<String> = exportLines.slice(exportScroll, exportScroll + EXPORT_LINES);
		exportText.text = shown.join('\n');
	}

	function updateExportPanel(elapsed:Float)
	{
		exportGroup.update(elapsed);

		if (FlxG.keys.justPressed.ESCAPE)
		{
			closeExportPanel();
			return;
		}
		if (FlxG.mouse.wheel != 0)
		{
			exportScroll -= FlxG.mouse.wheel * 3;
			refreshExportText();
		}
		if (FlxG.keys.justPressed.PAGEUP)
		{
			exportScroll -= EXPORT_LINES;
			refreshExportText();
		}
		if (FlxG.keys.justPressed.PAGEDOWN)
		{
			exportScroll += EXPORT_LINES;
			refreshExportText();
		}
	}

	function currentSongName():String
	{
		var s:String = (songDropDown != null && songDropDown.selectedLabel != null && songDropDown.selectedLabel.length > 0) ? songDropDown.selectedLabel : songName;
		return (s == null || s.length < 1) ? 'song' : s;
	}

	// -------------------------------------------------------------------
	// Salvataggio come file (opzionale): <song>_hud.lua
	// -------------------------------------------------------------------
	var _file:FileReference;

	function saveLuaFile()
	{
		if (_file != null)
			return;

		var fileName:String = currentSongName() + '_hud.lua';
		#if mobile
		StorageUtil.saveContent(fileName, exportLua);
		unsavedProgress = false;
		#else
		startSave(exportLua, fileName);
		#end
	}

	function startSave(content:String, name:String)
	{
		_file = new FileReference();
		_file.addEventListener(#if desktop Event.SELECT #else Event.COMPLETE #end, onSaveComplete);
		_file.addEventListener(Event.CANCEL, onSaveCancel);
		_file.addEventListener(IOErrorEvent.IO_ERROR, onSaveError);
		_file.save(content, name);
	}

	function clearSaveListeners()
	{
		if (_file == null)
			return;
		_file.removeEventListener(#if desktop Event.SELECT #else Event.COMPLETE #end, onSaveComplete);
		_file.removeEventListener(Event.CANCEL, onSaveCancel);
		_file.removeEventListener(IOErrorEvent.IO_ERROR, onSaveError);
		_file = null;
	}

	function onSaveComplete(_):Void
	{
		clearSaveListeners();
		unsavedProgress = false;
		FlxG.log.notice('Successfully saved file.');
	}

	function onSaveCancel(_):Void
	{
		clearSaveListeners();
	}

	function onSaveError(_):Void
	{
		clearSaveListeners();
		FlxG.log.error('Problem saving file');
	}

	// -------------------------------------------------------------------
	// Generazione Lua
	// -------------------------------------------------------------------
	function luaStr(s:String):String
		return "'" + s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n") + "'";

	function luaNum(v:Float):String
	{
		var f:Float = Math.round(v * 10000) / 10000;
		if (Math.isNaN(f))
			f = 0;
		return Std.string(f);
	}

	// Numero per codice Haxe (HScript): sempre con il punto decimale
	function hxNum(v:Float):String
	{
		var s:String = luaNum(v);
		if (s.indexOf('.') < 0 && s.indexOf('e') < 0)
			s += '.0';
		return s;
	}

	function differs(a:Float, b:Float):Bool
		return Math.abs(a - b) > 0.0001;

	function safeEase(name:String):String
		return EASE_LIST.contains(name) ? name : 'linear';

	function widgetKey(m:EditorMetaSprite):String
		return m.name; // i nomi dei widget coincidono con i nomi interni di PlayState

	function setLine(m:EditorMetaSprite, field:String, val:String):String
	{
		if (m.type == 'strum')
			return "setPropertyFromGroup('strumLineNotes', " + m.targetIndex + ", '" + field + "', " + val + ")";
		return "setProperty('" + widgetKey(m) + "." + field + "', " + val + ")";
	}

	// Solo il DIFF rispetto al default (se coincide: niente, per ridurre le collisioni con altri script)
	function staticLines(m:EditorMetaSprite):Array<String>
	{
		var l:Array<String> = [];
		var isCombo:Bool = (m.type == 'combo');

		if (differs(m.x, m.defaultX))
			l.push(setLine(m, 'x', luaNum(isCombo ? m.x - m.defaultX : m.x)));
		if (differs(m.y, m.defaultY))
			l.push(setLine(m, 'y', luaNum(isCombo ? m.y - m.defaultY : m.y)));
		if (differs(m.alpha, m.defaultAlpha))
			l.push(setLine(m, 'alpha', luaNum(m.alpha)));
		if (m.canRotate && differs(m.angle, 0))
			l.push(setLine(m, 'angle', luaNum(m.angle)));
		if (m.canScale && (differs(m.scale[0], m.defaultScaleX) || differs(m.scale[1], m.defaultScaleY)))
		{
			l.push(setLine(m, 'scale.x', luaNum(m.scale[0])));
			l.push(setLine(m, 'scale.y', luaNum(m.scale[1])));
		}

		// tiene coerenti le variabili "default" che usano i modchart
		if (m.type == 'strum')
		{
			var pre:String = (m.targetIndex >= 4) ? 'defaultPlayerStrum' : 'defaultOpponentStrum';
			var n:Int = m.targetIndex % 4;
			if (differs(m.x, m.defaultX))
				l.push(pre + 'X' + n + ' = ' + luaNum(m.x));
			if (differs(m.y, m.defaultY))
				l.push(pre + 'Y' + n + ' = ' + luaNum(m.y));
		}
		return l;
	}

	function haxeRef(t:HudTweenData):String
	{
		return switch (t.targetType)
		{
			case 'strum': 'PlayState.instance.strumLineNotes.members[' + t.targetIndex + ']';
			case 'overlay': "PlayState.instance.modchartSprites.get('" + t.targetName + "')";
			default: 'PlayState.instance.' + t.targetName;
		}
	}

	// Righe che AVVIANO il tween n (parte sempre dal valore A, poi va a B)
	function tweenLines(t:HudTweenData, n:Int):Array<String>
	{
		var L:Array<String> = [];
		if (t.keyframes != null && t.keyframes.length > 1)
		{
			L.push('-- tween chain ' + n + ': ' + t.targetName + ' (' + t.keyframes.length + ' keyframes)');
			L.push('runHaxeCode([[');
			L.push('var obj = ' + haxeRef(t) + ';');
			L.push('if (obj != null) {');
			var first = t.keyframes[0];
			L.push('obj.x = ' + hxNum(first.x) + '; obj.y = ' + hxNum(first.y) + '; obj.alpha = ' + hxNum(first.alpha) + '; obj.angle = ' + hxNum(first.angle) + ';');
			L.push('obj.scale.set(' + hxNum(first.scaleX) + ', ' + hxNum(first.scaleY) + ');');
			var cumulative:Float = t.delay;
			for (i in 0...(t.keyframes.length - 1))
			{
				var b = t.keyframes[i + 1];
				var values:Array<String> = [];
				if (t.propX) values.push('x: ' + hxNum(b.x));
				if (t.propY) values.push('y: ' + hxNum(b.y));
				if (t.propAlpha) values.push('alpha: ' + hxNum(b.alpha));
				if (t.propAngle) values.push('angle: ' + hxNum(b.angle));
				var dur = (b.duration > 0) ? b.duration : t.duration;
				var ease = safeEase(b.easing != null ? b.easing : t.easing);
				if (values.length > 0)
					L.push('FlxTween.tween(obj, {' + values.join(', ') + '}, ' + hxNum(dur) + ', {ease: FlxEase.' + ease + ', startDelay: ' + hxNum(cumulative) + '});');
				if (t.propScale && (b.scaleX != first.scaleX || b.scaleY != first.scaleY))
					L.push('FlxTween.tween(obj.scale, {x: ' + hxNum(b.scaleX) + ', y: ' + hxNum(b.scaleY) + '}, ' + hxNum(dur) + ', {ease: FlxEase.' + ease + ', startDelay: ' + hxNum(cumulative) + '});');
				cumulative += dur;
			}
			L.push('}');
			L.push(']])');
			return L;
		}
		var doX:Bool = t.propX && differs(t.fromX, t.toX);
		var doY:Bool = t.propY && differs(t.fromY, t.toY);
		var doA:Bool = t.propAlpha && differs(t.fromAlpha, t.toAlpha);
		var doAng:Bool = t.propAngle && differs(t.fromAngle, t.toAngle);
		var doS:Bool = t.propScale && differs(t.fromScale, t.toScale);

		if (!(doX || doY || doA || doAng || doS))
		{
			L.push('-- tween ' + n + ' (' + t.targetName + '): no property changes between A and B, skipped');
			return L;
		}

		var ease:String = safeEase(t.easing);
		var dur:String = luaNum(t.duration);
		var mode:String = t.yoyo ? ', yoyo (ping-pong)' : (t.loop ? ', loop' : '');
		L.push('-- tween ' + n + ': ' + t.targetName + ' (' + t.easing + ', ' + dur + 's' + (t.delay > 0 ? ', delay ' + luaNum(t.delay) + 's' : '') + mode + ')');

		var simple:Bool = (t.targetType == 'overlay' && t.delay <= 0 && !t.loop && !t.yoyo);
		if (simple)
		{
			// overlay: API stabile doTween*
			var tag:String = luaStr(t.targetName);
			var base:String = 'hudTween' + n;
			if (doX)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.x') + ', ' + luaNum(t.fromX) + ')');
				L.push('doTweenX(' + luaStr(base + '_x') + ', ' + tag + ', ' + luaNum(t.toX) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doY)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.y') + ', ' + luaNum(t.fromY) + ')');
				L.push('doTweenY(' + luaStr(base + '_y') + ', ' + tag + ', ' + luaNum(t.toY) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doA)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.alpha') + ', ' + luaNum(t.fromAlpha) + ')');
				L.push('doTweenAlpha(' + luaStr(base + '_a') + ', ' + tag + ', ' + luaNum(t.toAlpha) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doAng)
			{
				L.push('setProperty(' + luaStr(t.targetName + '.angle') + ', ' + luaNum(t.fromAngle) + ')');
				L.push('doTweenAngle(' + luaStr(base + '_ang') + ', ' + tag + ', ' + luaNum(t.toAngle) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			if (doS)
			{
				// Psych non ha doTweenScale: si tweena x/y dell'oggetto "scale"
				var sc:String = luaStr(t.targetName + '.scale');
				L.push('setProperty(' + luaStr(t.targetName + '.scale.x') + ', ' + luaNum(t.fromScale) + ')');
				L.push('setProperty(' + luaStr(t.targetName + '.scale.y') + ', ' + luaNum(t.fromScale) + ')');
				L.push('doTweenX(' + luaStr(base + '_sx') + ', ' + sc + ', ' + luaNum(t.toScale) + ', ' + dur + ', ' + luaStr(ease) + ')');
				L.push('doTweenY(' + luaStr(base + '_sy') + ', ' + sc + ', ' + luaNum(t.toScale) + ', ' + dur + ', ' + luaStr(ease) + ')');
			}
			return L;
		}

		// strum / widget nativi (e overlay con delay/loop/yoyo): runHaxeCode
		var opts:String = '{ease: FlxEase.' + ease + (t.delay > 0 ? ', startDelay: ' + hxNum(t.delay) : '') + (t.yoyo ? ', type: 4' : (t.loop ? ', type: 2' : '')) + '}';
		L.push('runHaxeCode([[');
		L.push('\tvar obj = ' + haxeRef(t) + ';');
		L.push('\tif (obj != null) {');
		if (doX)
			L.push('\t\tobj.x = ' + hxNum(t.fromX) + ';');
		if (doY)
			L.push('\t\tobj.y = ' + hxNum(t.fromY) + ';');
		if (doA)
			L.push('\t\tobj.alpha = ' + hxNum(t.fromAlpha) + ';');
		if (doAng)
			L.push('\t\tobj.angle = ' + hxNum(t.fromAngle) + ';');
		if (doS)
		{
			L.push('\t\tobj.scale.x = ' + hxNum(t.fromScale) + ';');
			L.push('\t\tobj.scale.y = ' + hxNum(t.fromScale) + ';');
		}

		var vals:Array<String> = [];
		if (doX)
			vals.push('x: ' + hxNum(t.toX));
		if (doY)
			vals.push('y: ' + hxNum(t.toY));
		if (doA)
			vals.push('alpha: ' + hxNum(t.toAlpha));
		if (doAng)
			vals.push('angle: ' + hxNum(t.toAngle));
		if (vals.length > 0)
			L.push('\t\tFlxTween.tween(obj, {' + vals.join(', ') + '}, ' + hxNum(t.duration) + ', ' + opts + ');');
		if (doS)
			L.push('\t\tFlxTween.tween(obj.scale, {x: ' + hxNum(t.toScale) + ', y: ' + hxNum(t.toScale) + '}, ' + hxNum(t.duration) + ', ' + opts + ');');
		L.push('\t}');
		L.push(']])');
		return L;
	}

	function indent(lines:Array<String>, prefix:String):Array<String>
		return [for (l in lines) (l.length > 0 ? prefix + l : l)];

	function generateLua():String
	{
		var song:String = currentSongName();
		var out:Array<String> = [];

		// ---- HEADER obbligatorio (identico alla specifica) ----
		out.push("-- ============================================================");
		out.push("-- HUD Layout — generated by Psych Engine HUD Editor");
		out.push("-- Song: " + song);
		out.push("-- ============================================================");
		out.push("--");
		out.push("-- COME USARLO:");
		out.push("--   Incolla questo codice in onCreatePost() del tuo");
		out.push("--   data/songs/" + song + "/" + song + ".lua, oppure salvalo come");
		out.push("--   " + song + "_hud.lua e caricalo con addLuaScript() in onCreatePost.");
		out.push("--");
		out.push("-- ORDINE DI ESECUZIONE:");
		out.push("--   Psych esegue i lua in sequenza e per le stesse proprietà vince");
		out.push("--   l'ultimo che scrive. Se un altro script tocca gli stessi elementi");
		out.push("--   DOPO questo codice, quel script vince. Non c'è merge automatico.");
		out.push("--   Incolla DOPO le tue modifiche se vuoi che l'editor abbia");
		out.push("--   l'ultima parola, PRIMA se vuoi che le tue vincano.");
		out.push("--");
		out.push("-- VERSIONE: testato su Psych 1.0.x vanilla. runHaxeCode per i");
		out.push("-- widget nativi richiede HScript abilitato. I nomi interni");
		out.push("-- (strumLineNotes, healthBar, ecc.) possono cambiare tra fork.");
		out.push("-- ============================================================");
		out.push("");

		// ---- Note dell'editor (aggiunte DOPO l'header obbligatorio) ----
		out.push("-- NOTE DELL'EDITOR:");
		out.push("--   * Modalita' assunta: downscroll=" + downscroll + ", middlescroll=" + middlescroll + ", 4K (il PlayState di questo fork e' solo 4K).");
		out.push("--     I diff sono calcolati rispetto ai default di quella modalita'; le posizioni emesse sono assolute.");
		out.push("--   * Strum: opponent = strumLineNotes 0-3, player = 4-7 (Psych 1.0.x vanilla; altri fork possono usare strumLineNotesP1/P2).");
		out.push("--   * Gli strum esistono solo dopo startCountdown(): le loro posizioni statiche stanno in onCountdownStarted().");
		out.push("--   * Se il tuo script ha GIA' onCreate/onCreatePost/onCountdownStarted/onBeatHit/onStepHit, in Lua resta solo l'ULTIMA");
		out.push("--     definizione di ogni funzione: copia i CORPI dentro le tue funzioni invece di incollare le funzioni intere.");
		out.push("--   * Un file " + song + "_hud.lua in data/songs/" + song + "/ viene caricato da Psych in automatico (non serve addLuaScript).");
		out.push("--   * Il tween parte sempre dal valore A (impostato subito prima del tween) e arriva a B.");
		out.push("--   * Draw order GLOBALE (non per-categoria): zIndex determina la sovrapposizione tra strum, widget e overlay.");
		out.push("--   * comboGroup: i valori x/y sono uno SPOSTAMENTO rispetto alla posizione normale (il gruppo parte da 0,0).");
		out.push("");

		// ---- Overlay (function onCreate) ----
		var overlays:Array<EditorMetaSprite> = [for (m in items) if (m.type == 'overlay') m];
		overlays.sort((a, b) -> a.zIndex - b.zIndex);
		if (overlays.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- OVERLAY IMPORTATI");
			out.push("-- ------------------------------------------------------------");
			out.push("function onCreate()");
			for (m in overlays)
			{
				var tag:String = luaStr(m.name);
				var img:String = luaStr(m.image);
				out.push("\t-- overlay: " + m.name);
				out.push("\t" + (m.animated ? "makeAnimatedLuaSprite(" : "makeLuaSprite(") + tag + ", " + img + ", " + luaNum(m.x) + ", " + luaNum(m.y) + ")");
				out.push("\tsetObjectCamera(" + tag + ", 'hud')");
				out.push("\tsetScrollFactor(" + tag + ", 0, 0)");
				if (differs(m.scale[0], 1) || differs(m.scale[1], 1))
					out.push("\tscaleObject(" + tag + ", " + luaNum(m.scale[0]) + ", " + luaNum(m.scale[1]) + ")");
				if (differs(m.alpha, 1))
					out.push("\tsetProperty(" + luaStr(m.name + '.alpha') + ", " + luaNum(m.alpha) + ")");
				if (differs(m.angle, 0))
					out.push("\tsetProperty(" + luaStr(m.name + '.angle') + ", " + luaNum(m.angle) + ")");
				if (m.flipX)
					out.push("\tsetProperty(" + luaStr(m.name + '.flipX') + ", true)");
				if (m.flipY)
					out.push("\tsetProperty(" + luaStr(m.name + '.flipY') + ", true)");
				if (!m.antialiasing)
					out.push("\tsetProperty(" + luaStr(m.name + '.antialiasing') + ", false)");
				if (m.animated && m.animations != null)
				{
					for (a in m.animations)
						out.push("\taddAnimationByPrefix(" + tag + ", " + luaStr(a.anim) + ", " + luaStr(a.name) + ", " + luaNum(a.fps) + ", " + (a.loop ? 'true' : 'false') + ")");
					if (m.firstAnimation != null)
						out.push("\tplayAnim(" + tag + ", " + luaStr(m.firstAnimation) + ", true)");
				}
				out.push("\taddLuaSprite(" + tag + ", true)");
				out.push("\tsetObjectOrder(" + tag + ", " + m.zIndex + ")");
				out.push("\tsetObjectOrder(" + tag + ", " + m.zIndex + ")");
				out.push("");
			}
			out.push("end");
			out.push("");
		}

		// ---- Raccolta: statici e tween ----
		var createPostStatic:Array<String> = [];
		var countdownStatic:Array<String> = [];
		for (m in items)
		{
			if (m.type == 'overlay')
				continue;
			var sl:Array<String> = staticLines(m);
			if (sl.length < 1)
				continue;
			var target:Array<String> = (m.type == 'strum') ? countdownStatic : createPostStatic;
			target.push('-- ' + m.name);
			for (l in sl)
				target.push(l);
		}

		// ordine: per trigger, poi per beat, poi per creazione
		var order:Array<Int> = [for (i in 0...hudTweens.length) i];
		order.sort(function(a:Int, b:Int):Int
		{
			var ta:HudTweenData = hudTweens[a];
			var tb:HudTweenData = hudTweens[b];
			var ra:Int = TRIGGER_LIST.indexOf(ta.trigger);
			var rb:Int = TRIGGER_LIST.indexOf(tb.trigger);
			if (ra != rb)
				return ra - rb;
			if (ta.triggerBeat != tb.triggerBeat)
				return ta.triggerBeat - tb.triggerBeat;
			return a - b;
		});

		var flags:Array<String> = [];
		var createPostTweens:Array<String> = [];
		var countdownTweens:Array<String> = [];
		var beatBlocks:Array<String> = [];
		var stepBlocks:Array<String> = [];
		var customNames:Array<String> = [];
		var customBodies:Map<String, Array<String>> = new Map();

		for (i in order)
		{
			var t:HudTweenData = hudTweens[i];
			if (indexOfTarget(t) < 0)
				continue;
			var n:Int = i + 1;
			var body:Array<String> = tweenLines(t, n);
			var flag:String = '__hudTween' + n + '_done';

			switch (t.trigger)
			{
				case 'onBeatHit', 'onStepHit':
					flags.push(flag + ' = false');
					var v:String = (t.trigger == 'onBeatHit') ? 'curBeat' : 'curStep';
					var block:Array<String> = [];
					block.push(body[0]); // commento del tween
					block.push('if ' + v + ' == ' + t.triggerBeat + ' and not ' + flag + ' then');
					block.push('\t' + flag + ' = true');
					for (k in 1...body.length)
						block.push('\t' + body[k]);
					block.push('end');
					for (l in block)
						((t.trigger == 'onBeatHit') ? beatBlocks : stepBlocks).push('\t' + l);

				case 'customFunction':
					var fn:String = (t.customFuncName != null && t.customFuncName.length > 0) ? t.customFuncName : 'hudTween' + n;
					if (!customBodies.exists(fn))
					{
						customBodies.set(fn, []);
						customNames.push(fn);
					}
					for (l in body)
						customBodies.get(fn).push('\t' + l);

				default: // onCreatePost
					var dest:Array<String> = (t.targetType == 'strum') ? countdownTweens : createPostTweens;
					for (l in body)
						dest.push('\t' + l);
			}
		}

		// ---- onCreatePost ----
		if (createPostStatic.length > 0 || flags.length > 0 || createPostTweens.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- POSIZIONI STATICHE (solo cio' che differisce dal default)");
			out.push("-- ------------------------------------------------------------");
			out.push("function onCreatePost()");
			for (l in createPostStatic)
				out.push("\t" + l);
			if (flags.length > 0)
			{
				out.push("");
				out.push("\t-- flag per tween one-shot");
				for (l in flags)
					out.push("\t" + l);
			}
			if (createPostTweens.length > 0)
			{
				out.push("");
				out.push("\t-- tween avviati alla creazione");
				for (l in createPostTweens)
					out.push(l);
			}
			out.push("end");
			out.push("");
		}

		// ---- onCountdownStarted (gli strum esistono solo qui) ----
		if (countdownStatic.length > 0 || countdownTweens.length > 0 || items.length > 0)
		{
			out.push("-- Gli strum vengono creati in startCountdown(), DOPO onCreatePost:");
			out.push("-- per questo le loro posizioni stanno qui.");
			out.push("function onCountdownStarted()");
			for (l in countdownStatic)
				out.push("\t" + l);
			for (l in countdownTweens)
				out.push(l);
			out.push("");
			out.push("\t-- Riordino globale: native HUD + overlay nello stesso stack di PlayState.members.");
			out.push("\trunHaxeCode([[");
			var orderedHud:Array<EditorMetaSprite> = items.copy();
			orderedHud.sort((a, b) -> a.zIndex - b.zIndex);
			var orderVars:Array<String> = [];
			var orderVar:Int = 0;
			for (m in orderedHud)
			{
				var ref = (m.type == 'strum') ? "PlayState.instance.strumLineNotes.members[" + m.targetIndex + "]" : (m.type == 'overlay' ? "PlayState.instance.modchartSprites.get('" + m.name + "')" : "PlayState.instance." + m.name);
				var objVar = "hudObj" + orderVar++;
				orderVars.push(objVar);
				out.push("var " + objVar + " = " + ref + ";");
			}
			out.push("var hudBase = PlayState.instance.members.length;");
			for (objVar in orderVars)
				out.push("if (" + objVar + " != null) hudBase--;");
			out.push("var hudPos = 0;");
			for (objVar in orderVars)
			{
				out.push("if (" + objVar + " != null) { PlayState.instance.remove(" + objVar + ", false); PlayState.instance.insert(hudBase + hudPos, " + objVar + "); hudPos++; }");
			}
			out.push("]])");
			out.push("end");
			out.push("");
		}

		// ---- Tween per trigger ----
		if (beatBlocks.length > 0 || stepBlocks.length > 0 || customNames.length > 0)
		{
			out.push("-- ------------------------------------------------------------");
			out.push("-- TWEEN");
			out.push("-- ------------------------------------------------------------");
		}
		if (beatBlocks.length > 0)
		{
			out.push("function onBeatHit()");
			for (l in beatBlocks)
				out.push(l);
			out.push("end");
			out.push("");
		}
		if (stepBlocks.length > 0)
		{
			out.push("function onStepHit()");
			for (l in stepBlocks)
				out.push(l);
			out.push("end");
			out.push("");
		}
		for (fn in customNames)
		{
			out.push("-- Funzione custom: NON viene chiamata automaticamente.");
			out.push("-- Chiamala da questo script con " + fn + "() oppure da un altro script con callOnLuas('" + fn + "', {}).");
			out.push("function " + fn + "()");
			for (l in customBodies.get(fn))
				out.push(l);
			out.push("end");
			out.push("");
		}

		if (overlays.length < 1 && createPostStatic.length < 1 && countdownStatic.length < 1 && hudTweens.length < 1)
			out.push("-- (nessuna modifica: l'HUD e' ai valori di default)");

		return out.join('\n');
	}

	// -------------------------------------------------------------------
	// Update
	// -------------------------------------------------------------------
	var showSelectionQuad:Bool = true;

	override function closeSubState()
	{
		super.closeSubState();
		controls.isInSubstate = false;
		removeTouchPad();
		addTouchPad('LEFT_FULL', 'CHARACTER_EDITOR');
		addTouchPadCamera();
		persistentUpdate = true;
	}

	override function update(elapsed:Float)
	{
		// modali: confirm, export, picker
		if (confirmOpen)
		{
			updateConfirm(elapsed);
			return;
		}
		if (exportOpen)
		{
			updateExportPanel(elapsed);
			return;
		}
		if (updatePngPicker())
			return;

		for (m in items)
			m.update(elapsed);

		super.update(elapsed);

		outputTime = Math.max(0, outputTime - elapsed);
		outputTxt.alpha = outputTime;

		if (previewRestoreTimer > 0)
		{
			previewRestoreTimer -= elapsed;
			if (previewRestoreTimer <= 0)
				stopPreview();
		}

		if (PsychUIInputText.focusOn != null)
			return;

		if (FlxG.keys.justPressed.ESCAPE || (touchPad != null && touchPad.buttonB.justPressed))
		{
			if (helpBg.visible)
			{
				helpBg.visible = helpTexts.visible = false;
				return;
			}
			if (tweenCaptureActive)
			{
				finishTweenCapture();
				return;
			}
			if (previewMeta != null)
			{
				stopPreview();
				return;
			}
			if (!unsavedProgress)
			{
				MusicBeatState.switchState(new states.editors.MasterEditorMenu());
				FlxG.sound.playMusic(Paths.music('freakyMenu'));
			}
			else
				openSubState(new HudEditorExitPrompt());
			return;
		}

		if (FlxG.keys.justPressed.F1)
			helpBg.visible = helpTexts.visible = !helpBg.visible;

		if (#if FLX_DEBUG FlxG.keys.justPressed.F3 #else FlxG.keys.justPressed.F2 #end)
		{
			UI_box.visible = !UI_box.visible;
			UI_box.active = !UI_box.active;
			spriteList_box.visible = spriteListRadioGroup.visible = UI_box.visible;
			spriteList_box.active = spriteListRadioGroup.active = UI_box.active;
			spriteListRadioGroup.updateRadioItems();
		}

		if (FlxG.keys.justPressed.H)
		{
			var visible = !(UI_box.visible && spriteList_box.visible);
			UI_box.visible = UI_box.active = visible;
			spriteList_box.visible = spriteList_box.active = visible;
			spriteListRadioGroup.visible = spriteListRadioGroup.active = visible;
			spriteListRadioGroup.updateRadioItems();
		}

		if (FlxG.keys.justPressed.F12)
			showSelectionQuad = !showSelectionQuad;

		if (FlxG.keys.justPressed.T)
			setTweenCaptureMode(!tweenCaptureMode);

		// W / S: elemento precedente / successivo
		if (listRefs.length > 0 && (FlxG.keys.justPressed.W || FlxG.keys.justPressed.S))
		{
			var dir:Int = FlxG.keys.justPressed.W ? -1 : 1;
			var cur:Int = spriteListRadioGroup.checked;
			var next:Int = FlxMath.wrap(cur + dir, 0, listRefs.length - 1);
			listSyncing = true;
			spriteListRadioGroup.checked = next;
			listSyncing = false;
			onListClick();
		}

		updateMouseObjectDrag();

		// Movimento con frecce / tasto destro
		var shiftMult:Float = FlxG.keys.pressed.SHIFT ? 4 : 1;
		var ctrlMult:Float = FlxG.keys.pressed.CONTROL ? 0.2 : 1;
		var moveX:Float = 0;
		var moveY:Float = 0;

		var tp:Bool = (touchPad != null);
		if (FlxG.keys.justPressed.LEFT || (tp && touchPad.buttonLeft.justPressed))
			moveX -= 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.RIGHT || (tp && touchPad.buttonRight.justPressed))
			moveX += 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.UP || (tp && touchPad.buttonUp.justPressed))
			moveY -= 5 * shiftMult * ctrlMult;
		if (FlxG.keys.justPressed.DOWN || (tp && touchPad.buttonDown.justPressed))
			moveY += 5 * shiftMult * ctrlMult;

		if (FlxG.mouse.justPressedRight)
			rightAccX = rightAccY = 0;
		if (FlxG.mouse.pressedRight && !rightDownOnUI && (FlxG.mouse.deltaScreenX != 0 || FlxG.mouse.deltaScreenY != 0))
		{
			// pixel dello schermo = pixel del mondo (camHUD ha zoom 1); tengo i decimali
			rightAccX += FlxG.mouse.deltaScreenX * ctrlMult;
			rightAccY += FlxG.mouse.deltaScreenY * ctrlMult;
			var stepX:Float = rightAccX < 0 ? Math.ceil(rightAccX) : Math.floor(rightAccX);
			var stepY:Float = rightAccY < 0 ? Math.ceil(rightAccY) : Math.floor(rightAccY);
			rightAccX -= stepX;
			rightAccY -= stepY;
			moveX += stepX;
			moveY += stepY;
		}

		if (moveX != 0 || moveY != 0)
		{
			var m:EditorMetaSprite = getSelected();
			if (m != null)
			{
				stopPreview();
				moveObjectTo(m, Math.round(m.x + moveX), Math.round(m.y + moveY));
			}
		}
	}

	function moveObjectTo(m:EditorMetaSprite, newX:Float, newY:Float)
	{
		m.x = newX;
		m.y = newY;
		unsavedProgress = true;
		refreshPosUI();
	}

	function isMouseOverUI():Bool
	{
		if (helpBg.visible || pngPickerOpen)
			return true;
		if (UI_box.visible && FlxG.mouse.overlaps(UI_box, camHUD))
			return true;
		if (spriteList_box.visible && FlxG.mouse.overlaps(spriteList_box, camHUD))
			return true;
		return false;
	}

	// Tutti gli elementi sotto il mouse: prima il selezionato, poi i piu' piccoli
	function getObjectsAtMouse():Array<Int>
	{
		var found:Array<{index:Int, area:Float}> = [];
		var px:Float = FlxG.mouse.screenX;
		var py:Float = FlxG.mouse.screenY;
		for (i in 0...items.length)
		{
			var m:EditorMetaSprite = items[i];
			if (m == null || m.sprite == null || !m.sprite.visible)
				continue;
			if (!m.hitTest(px, py, 6))
				continue;
			found.push({index: i, area: m.area()});
		}

		found.sort(function(a, b)
		{
			if (a.index == selectedIdx)
				return -1;
			if (b.index == selectedIdx)
				return 1;
			if (a.area != b.area)
				return a.area < b.area ? -1 : 1;
			return items[b.index].zIndex - items[a.index].zIndex; // a parita' di area vince quello disegnato sopra
		});
		return [for (f in found) f.index];
	}

	function updateMouseObjectDrag()
	{
		// CLICK DESTRO senza trascinare = annulla la cattura, altrimenti deseleziona
		if (FlxG.mouse.justPressedRight)
		{
			rightDownX = FlxG.mouse.screenX;
			rightDownY = FlxG.mouse.screenY;
			rightDownOnUI = isMouseOverUI();
		}
		if (FlxG.mouse.justReleasedRight && !rightDownOnUI)
		{
			var dist:Float = Math.abs(FlxG.mouse.screenX - rightDownX) + Math.abs(FlxG.mouse.screenY - rightDownY);
			if (dist < 4)
			{
				if (tweenCaptureActive)
					cancelTweenCapture();
				else if (selectedIdx >= 0)
					deselectAll();
			}
		}

		var ctrl:Bool = FlxG.keys.pressed.CONTROL;
		if (dragSprite != null)
		{
			if (!ctrl || !FlxG.mouse.pressed)
			{
				dragSprite = null;
				return;
			}

			// posizione assoluta: il punto afferrato resta sotto il cursore
			var newX:Float = Math.round(FlxG.mouse.screenX - dragPosX);
			var newY:Float = Math.round(FlxG.mouse.screenY - dragPosY);
			if (newX != dragSprite.x || newY != dragSprite.y)
			{
				moveObjectTo(dragSprite, newX, newY);
				dragMoved = true;
			}
			return;
		}

		if (ctrl && FlxG.mouse.justPressed && !isMouseOverUI())
		{
			// secondo Ctrl+click durante una cattura = punto B
			if (tweenCaptureActive)
			{
				var cm = tweenCaptureTarget;
				var kf = new HudTweenKeyframe(cm.x, cm.y, cm.alpha, cm.angle, cm.scale[0], cm.scale[1]);
				kf.duration = tweenTemplate.duration; kf.easing = tweenTemplate.easing;
				captureKeyframes.push(kf);
				dragSprite = cm;
				dragMoved = false;
				dragPosX = FlxG.mouse.screenX - cm.x;
				dragPosY = FlxG.mouse.screenY - cm.y;
				showOutput('Keyframe ' + (captureKeyframes.length) + ' saved. Move to the next point, Ctrl+click again or Finish.');
				return;
			}

			var candidates:Array<Int> = getObjectsAtMouse();
			var target:Int = -1;

			if (candidates.length > 0)
			{
				// stesso punto cliccato di nuovo: passa al prossimo elemento sovrapposto
				var now:Float = haxe.Timer.stamp();
				var sameSpot:Bool = Math.abs(FlxG.mouse.screenX - lastPickX) + Math.abs(FlxG.mouse.screenY - lastPickY) < 6
					&& now - lastPickTime < 2 && !dragMoved;
				pickCycle = sameSpot ? pickCycle + 1 : 0;
				lastPickX = FlxG.mouse.screenX;
				lastPickY = FlxG.mouse.screenY;
				lastPickTime = now;
				target = candidates[pickCycle % candidates.length];
			}
			else if (selectedIdx >= 0)
			{
				// click nel vuoto: muove comunque l'elemento selezionato (movimento relativo)
				target = selectedIdx;
				pickCycle = 0;
				lastPickX = -9999;
			}

			if (target >= 0)
			{
				if (target != selectedIdx)
					selectItem(target);
				stopPreview();
				dragSprite = items[target];
				dragMoved = false;
				dragPosX = FlxG.mouse.screenX - dragSprite.x;
				dragPosY = FlxG.mouse.screenY - dragSprite.y;

				// Ctrl+click in "Tween Capture Mode" = registra A
				if (tweenCaptureMode)
					beginTweenCapture(dragSprite);
			}
		}
	}

	// -------------------------------------------------------------------
	// Draw
	// -------------------------------------------------------------------
	override function draw()
	{
		if (persistentDraw || subState == null)
		{
			var drawItems = items.copy();
			drawItems.sort((a, b) -> a.zIndex - b.zIndex);
			for (m in drawItems)
				if (m.sprite != null && m.sprite.visible)
					m.draw();

			// ghost tratteggiato nella posizione A durante la cattura
			if (tweenCaptureActive && tweenCaptureTarget != null)
			{
				var tm:EditorMetaSprite = tweenCaptureTarget;
				var gr = tm.getRect();
				var gx:Float = gr.x + (tweenCaptureFromX - tm.x);
				var gy:Float = gr.y + (tweenCaptureFromY - tm.y);
				drawOutline(gx, gy, gr.w, gr.h, FlxColor.CYAN, 0.9, 2, true);
				drawOutline(gr.x, gr.y, gr.w, gr.h, FlxColor.YELLOW, 0.9, 2, false);
			}
			else if (showSelectionQuad)
			{
				var sel:EditorMetaSprite = getSelected();
				if (sel != null)
				{
					var r = sel.getRect();
					drawOutline(r.x, r.y, r.w, r.h, FlxColor.LIME, 0.9, 2, false);
				}
			}
		}

		super.draw();
	}

	function drawLine(x:Float, y:Float, w:Float, h:Float, color:FlxColor, alpha:Float)
	{
		linePx.color = color;
		linePx.alpha = alpha;
		linePx.scale.set(Math.max(1, w), Math.max(1, h));
		linePx.updateHitbox();
		linePx.x = x;
		linePx.y = y;
		linePx.draw();
	}

	function drawOutline(x:Float, y:Float, w:Float, h:Float, color:FlxColor, alpha:Float, t:Float, dashed:Bool)
	{
		if (!dashed)
		{
			drawLine(x, y, w, t, color, alpha);
			drawLine(x, y + h - t, w, t, color, alpha);
			drawLine(x, y, t, h, color, alpha);
			drawLine(x + w - t, y, t, h, color, alpha);
			return;
		}

		var dash:Float = 8;
		var gap:Float = 6;
		var cx:Float = x;
		while (cx < x + w)
		{
			var l:Float = Math.min(dash, x + w - cx);
			drawLine(cx, y, l, t, color, alpha);
			drawLine(cx, y + h - t, l, t, color, alpha);
			cx += dash + gap;
		}
		var cy:Float = y;
		while (cy < y + h)
		{
			var l:Float = Math.min(dash, y + h - cy);
			drawLine(x, cy, t, l, color, alpha);
			drawLine(x + w - t, cy, t, l, color, alpha);
			cy += dash + gap;
		}
	}

	override function destroy()
	{
		destroySubStates = true;
		stopPreview();
		clearSaveListeners();
		linePx = FlxDestroyUtil.destroy(linePx);
		super.destroy();
	}
}

class HudTweenKeyframe
{
	public var x:Float; public var y:Float; public var alpha:Float; public var angle:Float;
	public var scaleX:Float; public var scaleY:Float;
	public var duration:Float = 1.0; public var easing:String = 'quadInOut';
	public function new(x:Float, y:Float, alpha:Float, angle:Float, scaleX:Float, scaleY:Float)
	{ this.x=x; this.y=y; this.alpha=alpha; this.angle=angle; this.scaleX=scaleX; this.scaleY=scaleY; }
	public function sameAs(o:HudTweenKeyframe):Bool
		return x == o.x && y == o.y && alpha == o.alpha && angle == o.angle && scaleX == o.scaleX && scaleY == o.scaleY;
}


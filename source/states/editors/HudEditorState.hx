	// -------------------------------------------------------------------
	// Costruzione
	// -------------------------------------------------------------------
	override function create()
	{
		Paths.clearStoredMemory();
		Paths.clearUnusedMemory();

		// SOLO camHUD: e' la camera di default dello state (zoom 1, scroll 0, fissa)
		camHUD = initPsychCamera();
		camHUD.bgColor = 0xFF1B1B22;
		camHUD.zoom = 1;
		camHUD.scroll.set(0, 0);

		#if DISCORD_ALLOWED
		DiscordClient.changePresence('HUD Editor', null);
		#end

		linePx = new FlxSprite().makeGraphic(1, 1, FlxColor.WHITE);
		linePx.scrollFactor.set();

		var s:String = (Song.loadedSongName != null) ? Paths.formatToSongPath(Song.loadedSongName) : null;
		if (s != null && s.length > 0)
			songName = s;

		buildTemplate();

		screenUI();
		editorUI();
		buildExportPanel();
		buildConfirmPopup();
		addHelpScreen();
		buildPngPicker();
		refreshList();
		updateSelectedUI();

		FlxG.mouse.visible = true;

		addTouchPad('LEFT_FULL', 'CHARACTER_EDITOR');
		addTouchPadCamera();

		super.create();
	}

	// -------------------------------------------------------------------
	// Template HUD: widget VERI con placeholder (nessuna logica simulata)
	// -------------------------------------------------------------------
	function buildTemplate()
	{
		// 8 strum: 0-3 opponent, 4-7 player (stesso ordine di PlayState.strumLineNotes)
		for (i in 0...8)
		{
			var player:Int = (i >= 4) ? 1 : 0;
			var strum:StrumNote = new StrumNote(0, 0, i % 4, player);
			var m:EditorMetaSprite = new EditorMetaSprite('strum', 'strum_' + i, strum);
			m.targetIndex = i;
			items.push(m);
			applyDefaultPosition(m);
		}

		// healthBar (stessa firma di PlayState: Bar(x, y, 'healthBar', valueFunction, min, max))
		var hb:Bar = new Bar(0, 0, 'healthBar', function() return 1.0, 0, 2);
		hb.leftToRight = false;
		hb.setColors(FlxColor.RED, FlxColor.LIME);
		hb.scrollFactor.set();
		var mHb:EditorMetaSprite = new EditorMetaSprite('healthbar', 'healthBar', hb, true);
		items.push(mHb);
		applyDefaultPosition(mHb);

		// scoreTxt
		var score:FlxText = new FlxText(0, 0, FlxG.width, 'Score: 123456 | Misses: 0 | Rating: Sick! (100%) - SFC', 20);
		score.setFormat(Paths.font('vcr.ttf'), 20, FlxColor.WHITE, CENTER, FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
		score.scrollFactor.set();
		score.borderSize = 1.25;
		var mScore:EditorMetaSprite = new EditorMetaSprite('scoreText', 'scoreTxt', score);
		items.push(mScore);
		applyDefaultPosition(mScore);

		// timeTxt
		var timeTxt:FlxText = new FlxText(0, 0, 400, '1:23', 32);
		timeTxt.setFormat(Paths.font('vcr.ttf'), 32, FlxColor.WHITE, CENTER, FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
		timeTxt.scrollFactor.set();
		timeTxt.borderSize = 2;
		var mTimeTxt:EditorMetaSprite = new EditorMetaSprite('timeText', 'timeTxt', timeTxt);
		items.push(mTimeTxt);
		applyDefaultPosition(mTimeTxt);

		// timeBar (dipende da timeTxt per la Y: va creata DOPO)
		var tb:Bar = new Bar(0, 0, 'timeBar', function() return 0.5, 0, 1);
		tb.setColors(FlxColor.WHITE, FlxColor.BLACK);
		tb.scrollFactor.set();
		var mTb:EditorMetaSprite = new EditorMetaSprite('timeBar', 'timeBar', tb, true);
		items.push(mTb);
		applyDefaultPosition(mTb);

		// comboGroup: placeholder rettangolare. comboGroup parte da (0,0) e i
		// rating/combo vengono posizionati in coordinate assolute PRIMA di
		// essere aggiunti, quindi si sposta con un DELTA rispetto al default.
		var combo:FlxSprite = new FlxSprite().makeGraphic(200, 100, 0x00000000);
		drawPlaceholderBox(combo, 200, 100, 0xFFFFD34D, 'COMBO / RATING');
		combo.scrollFactor.set();
		var mCombo:EditorMetaSprite = new EditorMetaSprite('combo', 'comboGroup', combo);
		items.push(mCombo);
		applyDefaultPosition(mCombo);
		for (i in 0...items.length) items[i].zIndex = i;
		// Keep the timer bar above its text in the editor's global draw stack.
		mTb.zIndex = mTimeTxt.zIndex + 1;
	}

	// Disegna un rettangolo con bordo + etichetta dentro un FlxSprite
	function drawPlaceholderBox(spr:FlxSprite, w:Int, h:Int, border:FlxColor, label:String)
	{
		spr.makeGraphic(w, h, FlxColor.fromRGB(border.red, border.green, border.blue, 60));
		for (x in 0...w)
			for (t in 0...2)
			{
				spr.pixels.setPixel32(x, t, border);
				spr.pixels.setPixel32(x, h - 1 - t, border);
			}
		for (y in 0...h)
			for (t in 0...2)
			{
				spr.pixels.setPixel32(t, y, border);
				spr.pixels.setPixel32(w - 1 - t, y, border);
			}
		spr.dirty = true;
	}

	// Posizione di default di un elemento NON overlay, replicando PlayState.
	// Aggiorna anche defaultX/Y/Alpha del meta.
	function applyDefaultPosition(m:EditorMetaSprite)
	{
		var s:FlxSprite = m.sprite;
		switch (m.type)
		{
			case 'strum':
				var i:Int = m.targetIndex;
				var player:Int = (i >= 4) ? 1 : 0;
				var noteData:Int = i % 4;
				var strum:StrumNote = cast s;
				var strumLineX:Float = middlescroll ? PlayState.STRUM_X_MIDDLESCROLL : PlayState.STRUM_X;
				var strumLineY:Float = downscroll ? (FlxG.height - 150) : 50;
				strum.x = strumLineX;
				strum.y = strumLineY;
				strum.downScroll = downscroll;
				if (player == 0 && middlescroll)
				{
					strum.x += 310;
					if (noteData > 1)
						strum.x += FlxG.width / 2 + 25;
				}
				strum.playerPosition(); // aggiunge swagWidth*noteData + 50 + (width/2)*player
				m.defaultAlpha = (player == 0 && middlescroll) ? 0.35 : 1;

			case 'healthbar':
				s.screenCenter(X);
				s.y = FlxG.height * (!downscroll ? 0.89 : 0.11);

			case 'scoreText':
				s.x = 0;
				s.y = FlxG.height * (!downscroll ? 0.89 : 0.11) + 40;

			case 'timeText':
				s.x = PlayState.STRUM_X + (FlxG.width / 2) - 248;
				s.y = downscroll ? FlxG.height - 44 : 19;

			case 'timeBar':
				var tt:EditorMetaSprite = findItemByType('timeText');
				s.screenCenter(X);
				s.y = (tt != null ? tt.sprite.y + tt.sprite.height / 4 : 19);

			case 'combo':
				s.x = FlxG.width * 0.35 - 40;
				s.y = (FlxG.height - s.height) / 2 - 60;
		}
		m.defaultX = s.x;
		m.defaultY = s.y;
		if (m.type != 'strum')
			m.defaultAlpha = 1;
		s.alpha = m.defaultAlpha;
	}

	function findItemByType(type:String):EditorMetaSprite
	{
		for (m in items)
			if (m.type == type)
				return m;
		return null;
	}

	// Cambio downscroll/middlescroll: ricalcola i default. Gli elementi che
	// stavano al vecchio default seguono il nuovo; quelli spostati dall'utente restano.
	function onModeChanged()
	{
		stopPreview();
		if (tweenCaptureActive)
			cancelTweenCapture();

		for (m in items)
		{
			if (m.type == 'overlay')
				continue;

			var wasDefaultPos:Bool = (m.x == m.defaultX && m.y == m.defaultY);
			var wasDefaultAlpha:Bool = (m.alpha == m.defaultAlpha);
			var ox:Float = m.x;
			var oy:Float = m.y;
			var oa:Float = m.alpha;
			applyDefaultPosition(m);
			if (!wasDefaultPos)
			{
				m.x = ox;
				m.y = oy;
			}
			if (!wasDefaultAlpha)
				m.alpha = oa;
		}
		unsavedProgress = true;
		updateSelectedUI();
	}

	// -------------------------------------------------------------------
	// UI base
	// -------------------------------------------------------------------
	function screenUI()
	{
		spriteList_box = new PsychUIBox(25, 170, 250, 200, ['Elements']);
		spriteList_box.scrollFactor.set();
		spriteList_box.cameras = [camHUD];
		add(spriteList_box);
		addSpriteListBox();

		infoTxt = new FlxText(10, 4, 700, '', 14);
		infoTxt.setFormat(Paths.font('vcr.ttf'), 14, FlxColor.WHITE, LEFT, FlxTextBorderStyle.OUTLINE, FlxColor.BLACK);
		infoTxt.scrollFactor.set();
		infoTxt.cameras = [camHUD];
		add(infoTxt);

		outputTxt = new FlxText(0, 0, 800, '', 24);
		outputTxt.alignment = CENTER;
		outputTxt.borderStyle = OUTLINE_FAST;
		outputTxt.borderSize = 1;
		outputTxt.cameras = [camHUD];
		outputTxt.screenCenter();
		outputTxt.alpha = 0;
		add(outputTxt);
	}

	function addHelpScreen()
	{
		#if FLX_DEBUG
		var btn = 'F3';
		#else
		var btn = 'F2';
		#end

		var str:Array<String> = [
			'Ctrl + Left Click & Drag - Move the element (click again: cycle overlapping ones)',
			'Right Click & Drag / Arrow Keys - Move the selected element',
			'Right Click (no drag) - Deselect (or cancel a tween capture)',
			'W / S - Select previous / next element',
			'T - Toggle Tween Capture Mode',
			'   ON: Ctrl+Click saves A, then each Ctrl+Click adds a keyframe; Finish / ESC closes the chain',
			'   ESC / Finish = close chain; Right Click = cancel capture',
			'H - Toggle editor panels and object list',
			'',
			'F1 - This help',
			'$btn - Toggle UI panels',
			'Hold Shift - Move 4x faster',
			'Hold Control - Move pixel-by-pixel',
			'',
			'camHUD is fixed: zoom = 1, scroll = 0 (no camera control)'
		];

		helpBg = new FlxSprite().makeGraphic(1, 1, FlxColor.BLACK);
		helpBg.scale.set(FlxG.width, FlxG.height);
		helpBg.updateHitbox();
		helpBg.alpha = 0.7;
		helpBg.cameras = [camHUD];
		helpBg.active = helpBg.visible = false;
		add(helpBg);

		helpTexts = new FlxSpriteGroup();
		helpTexts.cameras = [camHUD];
		for (i => txt in str)
		{
			if (txt.length < 1)
				continue;

			var helpText:FlxText = new FlxText(0, 0, 900, txt, 16);
			helpText.setFormat(null, 16, FlxColor.WHITE, CENTER, OUTLINE_FAST, FlxColor.BLACK);
			helpText.borderColor = FlxColor.BLACK;
			helpText.scrollFactor.set();
			helpText.borderSize = 1;
			helpText.screenCenter();
			add(helpText);
			helpText.y += ((i - str.length / 2) * 28) + 16;
			helpText.active = false;
			helpTexts.add(helpText);
		}
		helpTexts.active = helpTexts.visible = false;
		add(helpTexts);
	}

	function showOutput(txt:String, isError:Bool = false)
	{
		outputTxt.color = isError ? FlxColor.RED : FlxColor.WHITE;
		outputTxt.text = txt;
		outputTime = 3;

		if (isError)
			FlxG.sound.play(Paths.sound('cancelMenu'), 0.4);
		else
			FlxG.sound.play(Paths.sound('scrollMenu'), 0.4);
	}

	// -------------------------------------------------------------------
	// Lista elementi (Strums / Widgets / Overlays / Tweens)
	// -------------------------------------------------------------------
	function addSpriteListBox()
	{
		var tab_group = spriteList_box.getTab('Elements').menu;
		spriteListRadioGroup = new PsychUIRadioGroup(10, 10, [], 25, 18, false, 200);
		spriteListRadioGroup.cameras = [camHUD];
		spriteListRadioGroup.onClick = onListClick;
		tab_group.add(spriteListRadioGroup);

		var buttonX = spriteList_box.x + spriteList_box.width - 10;
		var buttonY = spriteListRadioGroup.y - 30;

		var buttonImportPng:PsychUIButton = new PsychUIButton(buttonX, buttonY, 'Import PNG', openPngPicker);
		buttonImportPng.cameras = [camHUD];
		buttonImportPng.normalStyle.bgColor = FlxColor.ORANGE;
		buttonImportPng.normalStyle.textColor = FlxColor.WHITE;
		tab_group.add(buttonImportPng);

		var buttonDuplicate:PsychUIButton = new PsychUIButton(buttonX, buttonY + 30, 'Duplicate', function()
		{
			var m:EditorMetaSprite = getSelected();
			if (m == null || m.type != 'overlay')
			{
				showOutput('Select an overlay to duplicate.', true);
				return;
			}
			var copy:EditorMetaSprite = createOverlay(m.image, m.animations, m.animated);
			copy.name = findUnoccupiedName(m.name + '_copy');
			copy.setScale(m.scale[0], m.scale[1], true);
			copy.alpha = m.alpha;
			copy.angle = m.angle;
			copy.flipX = m.flipX;
			copy.flipY = m.flipY;
			copy.antialiasing = m.antialiasing;
			copy.x = m.x + 20;
			copy.y = m.y + 20;
			items.push(copy);
			selectedIdx = items.length - 1;
			refreshList();
			updateSelectedUI();
			unsavedProgress = true;
		});
		buttonDuplicate.cameras = [camHUD];
		buttonDuplicate.normalStyle.bgColor = FlxColor.BLUE;
		buttonDuplicate.normalStyle.textColor = FlxColor.WHITE;
		tab_group.add(buttonDuplicate);

		var buttonDelete:PsychUIButton = new PsychUIButton(buttonX, buttonY + 60, 'Delete', function()
		{
			var m:EditorMetaSprite = getSelected();
			if (m == null || m.type != 'overlay')
			{
				showOutput('Only overlays can be deleted.', true);
				return;
			}
			deleteOverlay(m);
		});
		buttonDelete.cameras = [camHUD];
		buttonDelete.normalStyle.bgColor = FlxColor.RED;
		buttonDelete.normalStyle.textColor = FlxColor.WHITE;
		tab_group.add(buttonDelete);
	}

	function deleteOverlay(m:EditorMetaSprite)
	{
		stopPreview();
		if (tweenCaptureActive)
			cancelTweenCapture();

		// elimina anche i tween che puntano a questo overlay
		hudTweens = [for (t in hudTweens) if (!(t.targetType == 'overlay' && t.targetName == m.name)) t];
		items.remove(m);
		m.sprite = FlxDestroyUtil.destroy(m.sprite);
		selectedIdx = -1;
		refreshList();
		updateSelectedUI();
		unsavedProgress = true;
	}

	function elementPrefix(m:EditorMetaSprite):String
	{
		return switch (m.type)
		{
			case 'strum': 'S| ';
			case 'overlay': 'O| ';
			default: 'W| ';
		}
	}

	function tweenLabel(t:HudTweenData):String
	{
		var trig:String = switch (t.trigger)
		{
			case 'onBeatHit': 'beat ' + t.triggerBeat;
			case 'onStepHit': 'step ' + t.triggerBeat;
			case 'customFunction': 'fn ' + t.customFuncName;
			default: 'start';
		}
		return 'T| ' + t.targetName + ' (' + trig + ')';
	}

	// Ricostruisce la lista (elementi raggruppati: Strums, Widgets, Overlays, poi Tweens)
	function refreshList()
	{
		listRefs = [];
		var labels:Array<String> = [];

		for (group in ['strum', 'widget', 'overlay'])
			for (i in 0...items.length)
			{
				var m:EditorMetaSprite = items[i];
				var g:String = (m.type == 'strum') ? 'strum' : (m.type == 'overlay' ? 'overlay' : 'widget');
				if (g != group)
					continue;
				listRefs.push({kind: 0, idx: i});
				labels.push(elementPrefix(m) + m.name);
			}

		for (i in 0...hudTweens.length)
		{
			listRefs.push({kind: 1, idx: i});
			labels.push(tweenLabel(hudTweens[i]));
		}

		listSyncing = true;
		spriteListRadioGroup.labels = labels;
		listSyncing = false;
		syncListSelection();

		final maxNum:Int = 19;
		spriteList_box.resize(250, Std.int(Math.min(maxNum, labels.length) * 25 + 35));
	}

	// Evidenzia nella lista l'elemento selezionato
	function syncListSelection()
	{
		listSyncing = true;
		spriteListRadioGroup.checked = -1;
		if (selectedIdx >= 0)
			for (n => ref in listRefs)
				if (ref.kind == 0 && ref.idx == selectedIdx)
				{
					spriteListRadioGroup.checked = n;
					break;
				}
		listSyncing = false;
	}

	var listSyncing:Bool = false;

	function onListClick()
	{
		if (listSyncing)
			return;
		var c:Int = spriteListRadioGroup.checked;
		if (c < 0 || c >= listRefs.length)
			return;

		stopPreview();
		if (tweenCaptureActive)
			cancelTweenCapture();

		var ref = listRefs[c];
		if (ref.kind == 0)
			selectedIdx = ref.idx;
		else
		{
			var t:HudTweenData = hudTweens[ref.idx];
			selectedIdx = indexOfTarget(t);
		}
		if (UI_box.selectedName == 'Settings')
			UI_box.selectedName = 'Object';
		updateSelectedUI();
	}

	function getSelected():EditorMetaSprite
		return (selectedIdx >= 0 && selectedIdx < items.length) ? items[selectedIdx] : null;

	function selectItem(index:Int)
	{
		stopPreview();
		selectedIdx = index;
		syncListSelection();
		if (UI_box.selectedName == 'Settings')
			UI_box.selectedName = 'Object';
		updateSelectedUI();
	}

	function deselectAll()
	{
		stopPreview();
		selectedIdx = -1;
		dragSprite = null;
		syncListSelection();
		updateSelectedUI();
	}

	function findUnoccupiedName(prefix:String = 'overlay'):String
	{
		var num:Int = 1;
		var name:String = prefix;
		while (true)
		{
			name = prefix + num;
			var used:Bool = HudEditorState.reservedLuaNames.contains(name);
			for (m in items)
				if (m.name == name)
				{
					used = true;
					break;
				}
			if (!used)
				break;
			num++;
		}
		return name;
	}


	function scanSongs():Array<String>
	{
		var list:Array<String> = [];
		#if sys
		var roots:Array<String> = ['mods/data/', 'assets/shared/data/'];
		if (Mods.currentModDirectory != null && Mods.currentModDirectory.length > 0)
			roots.push('mods/' + Mods.currentModDirectory + '/data/');
		for (root in roots)
		{
			if (!FileSystem.exists(root) || !FileSystem.isDirectory(root))
				continue;
			for (f in FileSystem.readDirectory(root))
				if (FileSystem.isDirectory(root + f) && !list.contains(f))
					list.push(f);
		}
		#end
		if (!list.contains(songName))
			list.insert(0, songName);
		return list;
	}

